"""
Variance diagnostics for the closed-form MedQA U-hat estimator.

Scans MedQA/closed_form/gpt_judge/ for all generations_closed_form_*
CSV files, computes the full set of variance diagnostics per model
(SD, floor fraction, ceiling fraction, distinct value count, tie
fraction), and prints a summary table plus saves it to CSV.

Run this directly from the calibration_explain directory, i.e.:
    cd ~/test/calibration_explain
    python3 variance_diagnostics_closed_form.py
"""

import pandas as pd
import numpy as np
import glob
import os
import re

# =====================================================
# CONFIG -- matches the folder structure shown in your explorer
# =====================================================

INPUT_DIR = "MedQA/closed_form/gpt_judge"
FILE_PATTERN = "generations_closed_form_*.csv"
OUTPUT_CSV = "MedQA/closed_form/gpt_judge/uhat_variance_diagnostics.csv"

# Candidate column names for the closed-form uncertainty estimate --
# the script will use whichever one is actually present in each file,
# since different pipeline versions may have named it differently.
UHAT_COLUMN_CANDIDATES = ["norm_uhat", "norm_ebse", "uhat", "entropy_norm"]

# Candidate column names for correctness, similarly flexible
CORRECT_COLUMN_CANDIDATES = ["correct", "correct_v2", "is_correct"]


def find_column(df, candidates, filename):
    """Return the first candidate column name present in df, or None."""
    for c in candidates:
        if c in df.columns:
            return c
    print(f"  WARNING [{filename}]: none of {candidates} found. "
          f"Columns present: {df.columns.tolist()}")
    return None


def variance_diagnostics(series):
    """
    Computes SD, floor fraction (U_hat < 0.01), ceiling fraction
    (U_hat > 0.99), number of distinct values (rounded to 6dp), and
    tie fraction (share of rows at the single most common value).
    """
    s = series.dropna().astype(float)
    n = len(s)
    if n == 0:
        return None

    sd = s.std()
    frac_floor = (s < 0.01).mean()
    frac_ceiling = (s > 0.99).mean()
    n_distinct = s.round(6).nunique()

    value_counts = s.round(6).value_counts()
    tie_fraction = value_counts.iloc[0] / n if len(value_counts) > 0 else 0
    most_common_value = value_counts.index[0] if len(value_counts) > 0 else None

    return {
        "n": n,
        "sd": sd,
        "frac_floor": frac_floor,
        "frac_ceiling": frac_ceiling,
        "n_distinct": n_distinct,
        "tie_fraction": tie_fraction,
        "most_common_value": most_common_value,
    }


def extract_model_name(filename):
    """
    Extracts a clean model label from filenames like
    generations_closed_form_llama_base_v2_gpt_judged.csv
    -> "llama_base"
    """
    match = re.search(r"generations_closed_form_(.+?)_v2", filename)
    if match:
        return match.group(1)
    return filename.replace(".csv", "")


# =====================================================
# RUN ACROSS ALL FILES IN THE FOLDER
# =====================================================

search_path = os.path.join(INPUT_DIR, FILE_PATTERN)
files = sorted(glob.glob(search_path))

print(f"Searching: {search_path}")
print(f"Found {len(files)} files.\n")

if len(files) == 0:
    print("No files found. Check that INPUT_DIR matches your actual path,")
    print("and that FILE_PATTERN matches your actual filenames.")
    print("Run this to check what's really there:")
    print(f'  ls "{INPUT_DIR}"')

results = []

for filepath in files:
    filename = os.path.basename(filepath)
    model_name = extract_model_name(filename)

    try:
        df = pd.read_csv(filepath)
    except Exception as e:
        print(f"SKIP {filename}: could not read ({e})")
        continue

    uhat_col = find_column(df, UHAT_COLUMN_CANDIDATES, filename)
    if uhat_col is None:
        continue

    correct_col = find_column(df, CORRECT_COLUMN_CANDIDATES, filename)

    diag = variance_diagnostics(df[uhat_col])
    if diag is None:
        print(f"SKIP {filename}: no valid {uhat_col} values")
        continue

    diag["model"] = model_name
    diag["file"] = filename
    diag["uhat_column_used"] = uhat_col

    # If correctness is available, also split diagnostics by group,
    # since floor/ceiling degeneracy could differ between correct and
    # incorrect subgroups even if the overall SD looks fine.
    if correct_col is not None:
        df[correct_col] = pd.to_numeric(df[correct_col], errors="coerce")
        correct_diag = variance_diagnostics(df[df[correct_col] == 1][uhat_col])
        incorrect_diag = variance_diagnostics(df[df[correct_col] == 0][uhat_col])
        if correct_diag:
            diag["sd_correct"] = correct_diag["sd"]
            diag["n_correct"] = correct_diag["n"]
        if incorrect_diag:
            diag["sd_incorrect"] = incorrect_diag["sd"]
            diag["n_incorrect"] = incorrect_diag["n"]

    results.append(diag)

    print(f"{model_name}")
    print(f"  file: {filename}")
    print(f"  column used: {uhat_col}")
    print(f"  n={diag['n']}")
    print(f"  SD={diag['sd']:.4f}")
    print(f"  fraction at floor (U<0.01):    {diag['frac_floor']:.1%}")
    print(f"  fraction at ceiling (U>0.99):  {diag['frac_ceiling']:.1%}")
    print(f"  distinct values observed:     {diag['n_distinct']}")
    print(f"  tie fraction (most common = {diag['most_common_value']:.4f}): {diag['tie_fraction']:.1%}")
    print()

# =====================================================
# SUMMARY TABLE
# =====================================================

if results:
    results_df = pd.DataFrame(results)
    cols_order = ["model", "n", "sd", "frac_floor", "frac_ceiling",
                  "n_distinct", "tie_fraction", "sd_correct", "sd_incorrect",
                  "n_correct", "n_incorrect", "uhat_column_used", "file"]
    cols_present = [c for c in cols_order if c in results_df.columns]
    results_df = results_df[cols_present]

    results_df.to_csv(OUTPUT_CSV, index=False)

    print("=" * 80)
    print("SUMMARY -- all models, closed-form U-hat variance diagnostics")
    print("=" * 80)
    print(results_df.to_string(index=False))

    print(f"\n{'=' * 80}")
    print("COMPARISON TO OLD SAMPLING-BASED ESTIMATOR")
    print("=" * 80)
    print("The old k=10 sampling estimator could only take values from a small")
    print("set of achievable fractions (0.0, ~0.32, 0.5, ~0.69, ~0.88, 0.97, 1.0")
    print("for k=10 with entropy over letter counts), producing heavy ties and")
    print("floor/ceiling mass in several cells. Compare 'n_distinct' above")
    print("against 200 (the sample size) -- values approaching 200 confirm the")
    print("closed-form estimator has effectively no ties, resolving the")
    print("reviewer's core objection.")

    print(f"\nFull diagnostics saved to: {OUTPUT_CSV}")
else:
    print("No valid files processed. Nothing to summarize.")
