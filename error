import pandas as pd
for model_file in ["llama_instruct_closed_form.csv", "qwen_base_closed_form.csv", ...]:
    df = pd.read_csv(model_file)
    s = df["norm_uhat"].dropna()  # or whatever the column is actually named
    print(f"{model_file}: SD={s.std():.4f}, floor%={(s<0.01).mean():.1%}, "
          f"ceiling%={(s>0.99).mean():.1%}, distinct={s.round(4).nunique()}")
