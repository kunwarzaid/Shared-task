"""
Hedging-licensed elicitation arm.

Tests whether Finding F3 (explanations remain highly supportive of
incorrect answers) is an artifact of the original post-hoc prompt's
framing ("provide an explanation for this answer", which presupposes
a justificatory stance), or whether it persists even when the model
is explicitly invited to disagree or hedge.

Everything is identical to the original post-hoc pipeline (same
questions, same greedy answers already generated, same model) EXCEPT
the explanation-elicitation prompt, which now explicitly licenses
hedging and disagreement. Only this one prompt changes; answer
generation and correctness labeling are unchanged and reused from
the existing post-hoc run.

Two possible outcomes, both informative (per the reviewer's framing):
  - Support for incorrect answers stays high (60-90) -> F3 is not an
    artifact of the original prompt's framing; the failure survives
    even when hedging is explicitly licensed.
  - Support for incorrect answers drops substantially -> the original
    prompt's justificatory framing was doing real work, and this
    constitutes a cheap, positive mitigation finding.

Run this reusing the SAME greedy answers already saved from your
existing post-hoc generation CSV, so only the explanation step is
regenerated -- no need to re-run answer generation or EBSE sampling.
"""

import os
import torch
import pandas as pd
from tqdm import tqdm
from transformers import AutoTokenizer, AutoModelForCausalLM
from huggingface_hub import login

# =====================================================
# CONFIG
# =====================================================

HF_TOKEN = ''
MODEL_NAME = "meta-llama/Llama-3.1-8B-Instruct"

MODEL_SHORT = MODEL_NAME.split("/")[-1]
IS_BASE_MODEL = "Instruct" not in MODEL_NAME

# Point this at your EXISTING post-hoc generation CSV for this model
# -- we reuse its questions, greedy answers, and correctness labels,
# regenerating ONLY the explanation with the new hedging-licensed prompt.
EXISTING_CSV = "medqa_llama_instruct_generations_v2.csv"  # adjust path/dataset as needed
DATASET_NAME = "medqa"  # or "strategyqa"

OUTPUT_DIR = f"/workspace/data/KZ_2117574/Calibration/hedging_arm/{MODEL_SHORT}_{DATASET_NAME}"
os.makedirs(OUTPUT_DIR, exist_ok=True)
OUTPUT_CSV = os.path.join(OUTPUT_DIR, "generations_hedging_licensed.csv")

print(f"Model: {MODEL_NAME} | Hedging-licensed elicitation | Dataset: {DATASET_NAME}")

# =====================================================
# LOGIN + MODEL
# =====================================================

login(token=HF_TOKEN)

print("Loading tokenizer...")
tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME, trust_remote_code=True)
if tokenizer.pad_token is None:
    tokenizer.pad_token = tokenizer.eos_token

print("Loading model...")
model = AutoModelForCausalLM.from_pretrained(
    MODEL_NAME, torch_dtype=torch.float16,
    device_map="auto", trust_remote_code=True
)
model.eval()
print("Model loaded.")

# =====================================================
# CHAT TEMPLATE HELPER
# =====================================================

def build_prompt(user_message):
    if tokenizer.chat_template is not None and not IS_BASE_MODEL:
        messages = [{"role": "user", "content": user_message}]
        prompt = tokenizer.apply_chat_template(
            messages, tokenize=False, add_generation_prompt=True
        )
    else:
        prompt = user_message
    return prompt

def clean_generated_text(text):
    for marker in ["\nQ:", "\nQuestion:"]:
        if marker in text:
            text = text.split(marker)[0].strip()
    return text

# =====================================================
# THE KEY CHANGE: hedging-licensed explanation prompt
# =====================================================
#
# ORIGINAL prompt (for comparison, do not use here):
#   "Question: {question}\n\nAnswer: {answer}\n\n
#    Provide an explanation for this answer:"
#
# This presupposes the answer is to be justified. The new prompt
# below explicitly asks the model to assess the answer's correctness
# and invites hedging or disagreement, removing the justificatory
# presupposition while keeping the task otherwise comparable.

def get_hedging_licensed_explanation(question, answer, is_base_model):
    if is_base_model:
        # Base models do not reliably follow complex instructions;
        # use the closest completion-style framing that still invites
        # assessment rather than pure justification.
        user_message = (
            f"Q: {question}\n"
            f"A: {answer}\n"
            f"Assessment of whether this answer is correct, including "
            f"any uncertainty:"
        )
    else:
        user_message = (
            f"Question: {question}\n\n"
            f"Answer: {answer}\n\n"
            f"Assess whether this answer is correct, and explain your "
            f"assessment. If you are uncertain whether the answer is "
            f"correct, say so explicitly and explain why."
        )
    prompt = build_prompt(user_message)

    inputs = tokenizer(
        prompt, return_tensors="pt", truncation=True, max_length=1536
    ).to(model.device)

    with torch.no_grad():
        output = model.generate(
            **inputs, max_new_tokens=250, do_sample=False,
            pad_token_id=tokenizer.pad_token_id,
            eos_token_id=tokenizer.eos_token_id
        )

    generated_tokens = output[0][inputs.input_ids.shape[1]:]
    explanation = tokenizer.decode(generated_tokens, skip_special_tokens=True).strip()
    explanation = clean_generated_text(explanation)
    return explanation

# =====================================================
# LOAD EXISTING DATA -- reuse questions, greedy answers,
# and correctness labels from the already-completed post-hoc run
# =====================================================

print(f"\nLoading existing post-hoc generations from: {EXISTING_CSV}")
existing_df = pd.read_csv(EXISTING_CSV)
print(f"Loaded {len(existing_df)} existing rows.")
print(f"Columns: {existing_df.columns.tolist()}")

# Determine the correctness column name based on dataset
correctness_col = "correct_v2" if DATASET_NAME == "medqa" else "correct"
if correctness_col not in existing_df.columns:
    # fall back gracefully
    correctness_col = "correct"

required_cols = ["question", "greedy_answer", correctness_col]
missing = [c for c in required_cols if c not in existing_df.columns]
if missing:
    raise ValueError(f"Existing CSV missing required columns: {missing}")

# =====================================================
# MAIN LOOP -- regenerate ONLY the explanation
# =====================================================

rows = []

for idx, row in tqdm(existing_df.iterrows(), total=len(existing_df)):

    question = row["question"]
    answer = row["greedy_answer"]
    correct = row[correctness_col]

    if pd.isna(answer) or pd.isna(correct):
        continue

    print(f"\n[{idx:03d}/{len(existing_df)}] {str(question)[:70]}...")

    try:
        hedging_explanation = get_hedging_licensed_explanation(
            question, answer, IS_BASE_MODEL
        )

        print(f"  correct={int(correct)} | expl_len={len(hedging_explanation)}")

        rows.append({
            "model": MODEL_SHORT,
            "condition": "hedging_licensed",
            "dataset": DATASET_NAME,
            "question": question,
            "greedy_answer": answer,
            "explanation": hedging_explanation,
            "correct": correct,
        })

    except Exception as e:
        print(f"  ERROR: {e}")
        rows.append({
            "model": MODEL_SHORT, "condition": "hedging_licensed",
            "dataset": DATASET_NAME, "question": question,
            "greedy_answer": answer, "explanation": None,
            "correct": correct,
        })

    if idx % 10 == 0:
        pd.DataFrame(rows).to_csv(OUTPUT_CSV, index=False)

df = pd.DataFrame(rows)
df.to_csv(OUTPUT_CSV, index=False)

print(f"\n{'='*60}")
print(f"HEDGING-LICENSED ELICITATION SUMMARY: {MODEL_SHORT} / {DATASET_NAME}")
print(f"{'='*60}")
print(f"Total: {len(df)}")
print(f"\nSaved to: {OUTPUT_CSV}")
print("\nNext step: run the existing support-score judge script on this")
print("file (same judge prompt, unchanged) to get support scores under")
print("the hedging-licensed condition, then compare TSG against the")
print("original post-hoc TSG for the same model/dataset.")
