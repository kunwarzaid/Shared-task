"""
Variance diagnostics for the communicated-uncertainty JUDGE SCORE
itself (gpt_perceived_uncertainty), matching the same methodology
already applied to U-hat in Table 3 / the logit-based variance audit.

This directly addresses the reviewer's concern: if the judge's
scores are themselves near-degenerate (e.g., most explanations
scored as fully confident, producing floor mass near 0), then a
near-zero Spearman correlation with U-hat could partly reflect range
restriction on the JUDGE side, not (or not only) a genuine absence
of coupling between predictive uncertainty and communicated
uncertainty.

Run this across all MedQA and StrategyQA judged CSVs, post-hoc and
joint. Reports SD, floor mass (score < 5, i.e. near-zero on the
0-100 scale), ceiling mass (score > 95), and number of distinct
values, per model-dataset-condition cell -- the judge-score
equivalent of Table 3.
"""

import os
import glob
import pandas as pd
import numpy as np

MODEL_KEYS = ["llama_base", "llama_instruct", "qwen_base", "qwen_instruct",
              "mistral_base", "mistral_instruct"]

# Adjust these to match your actual folder structure
SEARCH_DIRS = [
    ("MedQA/closed_form/gpt_judge", "generations_closed_form_*_v2_gpt_judge.csv", "MedQA", "posthoc"),
    ("MedQA/closed_form_joint/gpt_judge", "generations_closed_form_joint_*_gpt_judge.csv", "MedQA", "joint"),
    ("StrategyQA/gpt_judge", "*posthoc*gpt_judge.csv", "StrategyQA", "posthoc"),
    ("StrategyQA/gpt_judge", "*joint*gpt_judge.csv", "StrategyQA", "joint"),
]

OUTPUT_CSV = "judge_score_variance_diagnostics.csv"


def extract_model_key(filename):
    fname = filename.lower()
    for m in MODEL_KEYS:
        if m in fname:
            return m
        alt = m.replace("_", "")
        if alt in fname.replace("_", "").replace("-", ""):
            return m
    return None


def find_judge_col(df):
    for c in ["gpt_perceived_uncertainty", "gpt_uncertainty", "uncertainty_score"]:
        if c in df.columns:
            return c
    return None


def variance_diagnostics(series):
    s = series.dropna().astype(float)
    n = len(s)
    if n == 0:
        return None
    return {
        "n": n,
        "sd": s.std(),
        "mean": s.mean(),
        "frac_floor": (s < 5).mean(),
        "frac_ceiling": (s > 95).mean(),
        "n_distinct": s.round(2).nunique(),
    }


results = []

for search_dir, pattern, dataset, condition in SEARCH_DIRS:
    files = glob.glob(os.path.join(search_dir, pattern))
    print(f"\n{'='*70}")
    print(f"{dataset} / {condition}: found {len(files)} files in {search_dir}")
    print(f"{'='*70}")

    for filepath in sorted(files):
        filename = os.path.basename(filepath)
        model = extract_model_key(filename)
        if model is None:
            print(f"  SKIP {filename}: could not identify model")
            continue

        try:
            df = pd.read_csv(filepath)
        except Exception as e:
            print(f"  SKIP {filename}: {e}")
            continue

        judge_col = find_judge_col(df)
        if judge_col is None:
            print(f"  SKIP {filename}: no judge-score column found. "
                  f"Columns: {df.columns.tolist()}")
            continue

        diag = variance_diagnostics(df[judge_col])
        if diag is None:
            print(f"  SKIP {filename}: no valid judge scores")
            continue

        diag.update({"dataset": dataset, "condition": condition, "model": model,
                      "judge_column_used": judge_col, "file": filename})
        results.append(diag)

        print(f"  {model:18s} n={diag['n']:4d}  mean={diag['mean']:6.1f}  "
              f"SD={diag['sd']:6.2f}  floor%={diag['frac_floor']:.1%}  "
              f"ceiling%={diag['frac_ceiling']:.1%}  distinct={diag['n_distinct']}")

if results:
    results_df = pd.DataFrame(results)
    cols = ["dataset", "condition", "model", "n", "mean", "sd",
            "frac_floor", "frac_ceiling", "n_distinct", "judge_column_used", "file"]
    results_df = results_df[[c for c in cols if c in results_df.columns]]
    results_df.to_csv(OUTPUT_CSV, index=False)

    print(f"\n{'='*70}")
    print("SUMMARY -- cells with concerning judge-score variance")
    print(f"{'='*70}")
    concerning = results_df[
        (results_df["frac_floor"] > 0.3) |
        (results_df["frac_ceiling"] > 0.3)
    ]
    if len(concerning) > 0:
        print(concerning.to_string(index=False))
    else:
        print("No cells exceed the 30% floor/ceiling threshold.")

    print(f"\nOverall judge-score SD across all cells: "
          f"mean={results_df['sd'].mean():.2f}, "
          f"range=[{results_df['sd'].min():.2f}, {results_df['sd'].max():.2f}]")
    print(f"Full diagnostics saved to: {OUTPUT_CSV}")
else:
    print("\nNo files processed. Check SEARCH_DIRS match your actual paths.")
