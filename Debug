def compute_entropy(probs):
    """
    Compute entropy over discrete probabilities.
    Handles the p=1.0 edge case exactly, avoiding
    floating point artifacts from epsilon addition.
    """
    probs = np.array(probs)
    nonzero = probs[probs > 0]
    entropy = -np.sum(nonzero * np.log(nonzero))
    return max(entropy, 0.0)

