"""
Two things in one script, run after judge_hedging_uncertainty.py:

1. Quality check on the judge output (same instinct as every other
   judge run in this project -- catch failures/degenerate scores
   before trusting them).
2. Compute ECE_exp under assessment framing for each of the six MedQA
   hedging files, and compare directly against the existing
   justificatory-condition numbers already established for the AAAI
   paper (Table 2 / Table 4) -- this is the actual test of whether
   assessment framing recovers resolution on MedQA the way it did on
   ECQA, or whether MedQA stays degenerate regardless of prompt.
"""
import glob
import os
import numpy as np
import pandas as pd

# =====================================================
# CONFIG
# =====================================================
INPUT_DIR = "MedQA/hedging/gpt_judge"  # adjust to your real path
INPUT_PATTERN = "*_gpt_judge.csv"
N_BINS = 10
N_BOOTSTRAP = 1000
RNG_SEED = 42
SEVERE_BIN_COLLAPSE_THRESHOLD = 2

# Existing justificatory-condition numbers, MedQA post-hoc, already
# established and verified multiple times for the AAAI paper (Table 2
# ECE_exp, Table 4 resolution %). Model name must match whatever your
# judged files identify -- edit the keys below if your 'model' column
# uses different short names.
JUSTIFICATORY_REFERENCE = {
    "Llama-3.1-8B":             {"ECE_exp": 0.467, "resolution_pct": 0.0},
    "Llama-3.1-8B-Instruct":    {"ECE_exp": 0.283, "resolution_pct": 0.3},
    "Mistral-7B-v0.1":          {"ECE_exp": 0.563, "resolution_pct": 0.0},
    "Mistral-7B-Instruct-v0.3": {"ECE_exp": 0.338, "resolution_pct": 0.0},
    "Qwen2.5-7B":               {"ECE_exp": 0.308, "resolution_pct": 3.0},
    "Qwen2.5-7B-Instruct":      {"ECE_exp": 0.265, "resolution_pct": 0.0},
}


# =====================================================
# CORE ECE FUNCTIONS -- identical to the validated pipeline
# =====================================================
def ece_score(confidence, outcome, n_bins=N_BINS, strategy="quantile"):
    confidence = np.asarray(confidence, dtype=float)
    outcome = np.asarray(outcome, dtype=float)
    n = len(confidence)
    if n == 0:
        return np.nan, []
    if strategy == "quantile":
        edges = np.unique(np.quantile(confidence, np.linspace(0, 1, n_bins + 1)))
        if len(edges) < 2:
            edges = np.array([confidence.min(), confidence.max() + 1e-9])
    else:
        edges = np.linspace(confidence.min(), confidence.max() + 1e-9, n_bins + 1)
    bin_ids = np.digitize(confidence, edges[1:-1], right=True)
    ece = 0.0
    bin_stats = []
    for b in range(len(edges) - 1):
        mask = bin_ids == b
        count = mask.sum()
        if count == 0:
            continue
        avg_conf = confidence[mask].mean()
        avg_outcome = outcome[mask].mean()
        weight = count / n
        ece += weight * abs(avg_conf - avg_outcome)
        bin_stats.append({"bin": b, "count": int(count)})
    return ece, bin_stats


def calibration_in_the_large(confidence, outcome):
    confidence = np.asarray(confidence, dtype=float)
    outcome = np.asarray(outcome, dtype=float)
    return abs(confidence.mean() - outcome.mean())


def bootstrap_ci(confidence, outcome, n_boot=N_BOOTSTRAP, seed=RNG_SEED):
    rng = np.random.default_rng(seed)
    confidence = np.asarray(confidence)
    outcome = np.asarray(outcome)
    n = len(confidence)
    stats = []
    for _ in range(n_boot):
        idx = rng.integers(0, n, n)
        val, _ = ece_score(confidence[idx], outcome[idx], strategy="quantile")
        stats.append(val)
    stats = np.array(stats)
    return float(np.percentile(stats, 2.5)), float(np.percentile(stats, 97.5))


# =====================================================
# PART 1: QUALITY CHECK
# =====================================================
files = sorted(glob.glob(os.path.join(INPUT_DIR, INPUT_PATTERN)))
print(f"Found {len(files)} judged hedging files.\n")

if not files:
    raise FileNotFoundError(f"No files matched {os.path.join(INPUT_DIR, INPUT_PATTERN)}.")

print("="*70)
print("PART 1: JUDGE OUTPUT QUALITY CHECK")
print("="*70)
for path in files:
    df = pd.read_csv(path)
    scores = df["gpt_perceived_uncertainty"]
    reasons = df["gpt_reason"].astype(str)
    n_failed = reasons.str.contains("failed after", na=False).sum()
    n_empty_skip = reasons.str.contains("empty explanation", na=False).sum()
    valid = scores.dropna()
    print(f"\n{os.path.basename(path)}: n_valid={len(valid)}/{len(df)} | "
          f"API failures={n_failed} | empty-explanation skips={n_empty_skip}")
    if len(valid):
        print(f"  mean={valid.mean():.1f} sd={valid.std():.1f} "
              f"nunique={valid.nunique()} "
              f"pct_at_0={(valid==0).mean():.1%} pct_at_100={(valid==100).mean():.1%}")
        if valid.std() < 1.0:
            print(f"  WARNING: near-zero variance -- check this file before trusting its ECE.")

# =====================================================
# PART 2: ECE_exp UNDER ASSESSMENT FRAMING, VS JUSTIFICATORY REFERENCE
# =====================================================
print("\n" + "="*70)
print("PART 2: ECE_exp COMPARISON -- ASSESSMENT vs JUSTIFICATORY FRAMING")
print("="*70)

results = []
for path in files:
    df = pd.read_csv(path)
    model = df["model"].iloc[0] if "model" in df.columns else os.path.basename(path)

    certainty = 1 - (df["gpt_perceived_uncertainty"].astype(float).values / 100.0)
    correct = df["correct"].astype(float).values
    valid_mask = ~np.isnan(certainty) & ~np.isnan(correct)
    n_dropped = int((~valid_mask).sum())
    conf = certainty[valid_mask]
    out = correct[valid_mask]

    if len(conf) == 0:
        print(f"\n{model}: no valid rows, skipping.")
        continue

    ece, bins = ece_score(conf, out, strategy="quantile")
    ci_lo, ci_hi = bootstrap_ci(conf, out)
    citl = calibration_in_the_large(conf, out)
    resolution_residual = ece - citl
    resolution_pct = (resolution_residual / ece * 100) if ece > 0 else 0.0
    severe = len(bins) <= SEVERE_BIN_COLLAPSE_THRESHOLD

    ref = JUSTIFICATORY_REFERENCE.get(model)
    row = {
        "model": model,
        "n_valid": len(conf),
        "n_dropped": n_dropped,
        "ECE_exp_assessment": ece,
        "ECE_exp_assessment_CI_lo": ci_lo,
        "ECE_exp_assessment_CI_hi": ci_hi,
        "n_bins_used": len(bins),
        "resolution_pct_assessment": resolution_pct,
        "severe_flag": severe,
    }
    if ref:
        row["ECE_exp_justificatory"] = ref["ECE_exp"]
        row["resolution_pct_justificatory"] = ref["resolution_pct"]
        row["delta_ECE_exp"] = ece - ref["ECE_exp"]
        row["delta_resolution_pct"] = resolution_pct - ref["resolution_pct"]
    else:
        print(f"  NOTE: no justificatory reference found for model name {model!r} -- "
              f"check JUSTIFICATORY_REFERENCE keys match your 'model' column values.")

    results.append(row)

    print(f"\n{model}:")
    print(f"  ECE_exp (assessment) = {ece:.4f}  [{ci_lo:.4f}, {ci_hi:.4f}]  "
          f"n_bins={len(bins)}{'  SEVERE' if severe else ''}")
    print(f"  resolution: {resolution_pct:.1f}% (assessment)"
          + (f" vs {ref['resolution_pct']:.1f}% (justificatory)" if ref else ""))
    if ref:
        print(f"  ECE_exp justificatory was {ref['ECE_exp']:.4f} -> "
              f"delta = {ece - ref['ECE_exp']:+.4f}")

summary = pd.DataFrame(results)
summary.to_csv("hedging_ece_comparison.csv", index=False)
print(f"\n{'='*70}\nSaved comparison table to hedging_ece_comparison.csv\n{'='*70}")
print(summary.to_string(index=False))
