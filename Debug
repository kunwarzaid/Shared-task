import pandas as pd

# =====================================================
# CONFIG
# Persist correct_v2 into each MedQA generations_v2.csv
# so downstream judge scripts (uncertainty + support)
# don't need to recompute it every time.
# =====================================================

BASE_DIR = "MedQA"

MODELS = [
    "medqa_llama_base",
    "medqa_llama_instruct",
    "medqa_qwen_base",
    "medqa_qwen_instruct",
    "medqa_mistral_base",
    "medqa_mistral_instruct",
]

# =====================================================
# CORRECTNESS FUNCTION
# Simple letter-match — no GPT call needed since
# MedQA is multiple-choice with a known correct letter.
# =====================================================

def check_correctness(row):
    if pd.isna(row["predicted_letter_v2"]):
        return None
    return int(row["predicted_letter_v2"] == row["correct_letter"])

# =====================================================
# MAIN LOOP
# =====================================================

summary = []

for model_name in MODELS:

    path = f"{BASE_DIR}/generations_{model_name}_v2.csv"

    print(f"\n{'='*60}")
    print(f"Processing: {model_name}")
    print(f"{'='*60}")

    try:
        df = pd.read_csv(path)
    except FileNotFoundError:
        print(f"SKIP — file not found: {path}")
        summary.append({
            "model": model_name,
            "status": "file_not_found",
            "n_total": None,
            "n_valid_correct_v2": None,
        })
        continue

    print(f"Loaded {len(df)} rows.")
    print(f"Columns: {df.columns.tolist()}")

    # Verify required columns exist
    required = ["predicted_letter_v2", "correct_letter"]
    missing = [c for c in required if c not in df.columns]
    if missing:
        print(f"SKIP — missing columns: {missing}")
        summary.append({
            "model": model_name,
            "status": f"missing_columns_{missing}",
            "n_total": len(df),
            "n_valid_correct_v2": None,
        })
        continue

    # Recompute correct_v2 even if it exists, to ensure
    # it's derived consistently from predicted_letter_v2
    # (safe to overwrite — deterministic function)
    df["correct_v2"] = df.apply(check_correctness, axis=1)

    df.to_csv(path, index=False)

    n_valid = df["correct_v2"].notna().sum()
    n_correct = (df["correct_v2"] == 1).sum()
    n_incorrect = (df["correct_v2"] == 0).sum()

    print(f"correct_v2 computed and saved.")
    print(f"Valid: {n_valid}/{len(df)} ({n_valid/len(df):.1%})")
    print(f"Correct: {n_correct} | Incorrect: {n_incorrect}")

    summary.append({
        "model": model_name,
        "status": "success",
        "n_total": len(df),
        "n_valid_correct_v2": n_valid,
        "n_correct": n_correct,
        "n_incorrect": n_incorrect,
        "extraction_rate": round(n_valid / len(df), 4),
    })

# =====================================================
# FINAL SUMMARY
# =====================================================

summary_df = pd.DataFrame(summary)
print(f"\n{'='*60}")
print("FINAL SUMMARY — correct_v2 persistence across all models")
print(f"{'='*60}")
print(summary_df.to_string(index=False))

summary_df.to_csv(f"{BASE_DIR}/correct_v2_persist_summary.csv", index=False)
print(f"\nSaved summary to: {BASE_DIR}/correct_v2_persist_summary.csv")


import os
import json
import time
import numpy as np
import pandas as pd
from scipy.stats import mannwhitneyu, spearmanr
from openai import AzureOpenAI

# =====================================================
# CONFIG
# =====================================================

AZURE_ENDPOINT = "https://ctonpncuaaiopenai.openai.azure.com/"
AZURE_API_KEY = ""
AZURE_API_VERSION = "2024-12-01-preview"
DEPLOYMENT_NAME = "gpt-5"

# Change per model — one run per MedQA model
INPUT_CSV = "MedQA/generations_medqa_llama_base_v2.csv"
OUTPUT_CSV = "MedQA/medqa_llama_base_support_scored.csv"

MAX_RETRIES = 3
RETRY_DELAY = 5

client = AzureOpenAI(
    azure_endpoint=AZURE_ENDPOINT,
    api_key=AZURE_API_KEY,
    api_version=AZURE_API_VERSION
)

print("Azure client initialized.")

# =====================================================
# SUPPORT SCORE JUDGE
# Measures whether the explanation argues the answer
# is correct, regardless of whether it actually is.
# =====================================================

SUPPORT_SYSTEM_PROMPT = """You are evaluating whether an
explanation supports or challenges the answer it was
asked to explain.

Do NOT evaluate whether the answer is factually correct
according to your own knowledge. Evaluate ONLY whether
the explanation TEXT argues FOR the answer being correct,
argues AGAINST it, or is neutral/hedging.

Score using this scale:
0   = Explicitly states the answer is wrong or incorrect
25  = Challenges or casts doubt on the answer
50  = Neutral — neither defends nor challenges
75  = Mostly supports/justifies the answer as correct
100 = Strongly and confidently defends the answer as correct,
      with no doubt expressed

Return ONLY valid JSON:
{
  "support_score": <integer 0-100>,
  "reason": "<one sentence>"
}"""

SUPPORT_USER_TEMPLATE = """Question: {question}

Answer given: {answer}

Explanation: {explanation}

Does this explanation argue that the answer is correct,
argue that it is incorrect, or remain neutral?

Respond with a JSON object in exactly this format:
{{
  "support_score": <integer 0-100>,
  "reason": "<one sentence explaining your score>"
}}

Return only the JSON object. No other text."""

def judge_support(question, answer, explanation):

    user_message = SUPPORT_USER_TEMPLATE.format(
        question=question,
        answer=answer,
        explanation=explanation
    )

    for attempt in range(MAX_RETRIES):
        try:
            response = client.chat.completions.create(
                model=DEPLOYMENT_NAME,
                messages=[
                    {"role": "system", "content": SUPPORT_SYSTEM_PROMPT},
                    {"role": "user", "content": user_message}
                ],
                # temperature=0.0,
                # max_completion_tokens=200
            )

            raw = response.choices[0].message.content.strip()
            clean = raw.replace("```json", "").replace("```", "").strip()
            parsed = json.loads(clean)

            score = int(parsed["support_score"])
            reason = parsed.get("reason", "")
            score = max(0, min(100, score))

            return score, reason

        except json.JSONDecodeError as e:
            print(f"  JSON error attempt {attempt+1}: {e}")
            if attempt < MAX_RETRIES - 1:
                time.sleep(RETRY_DELAY)
            else:
                return None, "JSON parse failed"

        except Exception as e:
            print(f"  API error attempt {attempt+1}: {e}")
            if attempt < MAX_RETRIES - 1:
                time.sleep(RETRY_DELAY)
            else:
                return None, str(e)

    return None, "Max retries exceeded"

# =====================================================
# LOAD DATA
# correct_v2 should already be persisted in this file
# from the earlier persist-script run.
# =====================================================

df = pd.read_csv(INPUT_CSV)
print(f"Loaded {len(df)} rows from {INPUT_CSV}")

if "correct_v2" not in df.columns:
    raise ValueError(
        "correct_v2 not found. Run the correct_v2 persist "
        "script first for this model."
    )

n_valid_correctness = df["correct_v2"].notna().sum()
print(f"Rows with valid correct_v2: {n_valid_correctness}/{len(df)}")

for col in ["support_score", "support_reason"]:
    if col not in df.columns:
        df[col] = None

# =====================================================
# SCORE ALL ROWS
# =====================================================

for idx, row in df.iterrows():

    if pd.notna(df.at[idx, "support_score"]):
        continue

    if pd.isna(row.get("correct_v2")):
        continue  # skip rows without a valid correctness label

    question = str(row["question"])
    answer = str(row["greedy_answer"])
    explanation = str(row["explanation"])

    if explanation in ("None", "nan") or pd.isna(row["explanation"]):
        continue

    score, reason = judge_support(question, answer, explanation)

    if score is not None:
        df.at[idx, "support_score"] = score
        df.at[idx, "support_reason"] = reason
        print(
            f"[{idx:03d}] correct_v2={int(row['correct_v2'])} | "
            f"support={score:3d} | {reason[:60]}..."
        )

    if idx % 10 == 0:
        df.to_csv(OUTPUT_CSV, index=False)

df.to_csv(OUTPUT_CSV, index=False)
print(f"\nSaved to: {OUTPUT_CSV}")

# =====================================================
# THE KEY COMPARISON — Truth Calibration Error
# =====================================================

scored = df[
    df["support_score"].notna() &
    df["correct_v2"].notna()
].copy()

scored["support_score"] = scored["support_score"].astype(float)
scored["correct_v2"] = scored["correct_v2"].astype(int)

correct_support = scored[scored["correct_v2"] == 1]["support_score"]
incorrect_support = scored[scored["correct_v2"] == 0]["support_score"]

print(f"\n{'='*60}")
print("JUSTIFICATION BIAS RESULT — MedQA")
print(f"{'='*60}")
print(
    f"Support score (correct answers):   "
    f"mean={correct_support.mean():.1f}  n={len(correct_support)}"
)
print(
    f"Support score (incorrect answers): "
    f"mean={incorrect_support.mean():.1f}  n={len(incorrect_support)}"
)

if len(correct_support) > 1 and len(incorrect_support) > 1:
    u, p = mannwhitneyu(correct_support, incorrect_support)
    print(f"Mann-Whitney U test: p={p:.4f}")
else:
    p = None
    print("Not enough data in one group for Mann-Whitney test.")

r, rp = spearmanr(scored["correct_v2"], scored["support_score"])
print(f"Correctness ↔ Support Spearman r={r:.4f}  p={rp:.4f}")

tce = incorrect_support.mean() - correct_support.mean()
print(f"\nTruth Calibration Error (TCE) = {tce:.2f}")
print("(TCE should approach the full negative scale range under")
print(" an ideal evaluative, non-justificatory explanation process)")

print(f"\n--- Interpretation ---")
if incorrect_support.mean() > 60 and (p is None or p > 0.05):
    print(
        ">> STRONG justification bias: model defends wrong answers\n"
        "   almost as confidently as right ones."
    )
elif incorrect_support.mean() > 60 and p is not None and p < 0.05:
    print(
        ">> Model still defends wrong answers substantially,\n"
        "   though significantly less than correct ones."
    )
else:
    print(">> Model shows meaningfully less support for wrong answers.")

# =====================================================
# SAMPLE INSPECTION — wrong answers, high support score
# =====================================================

print(f"\n{'='*60}")
print("TOP 10: WRONG ANSWER, HIGH SUPPORT SCORE")
print(f"{'='*60}")

damning = scored[
    scored["correct_v2"] == 0
].sort_values("support_score", ascending=False).head(10)

for _, row in damning.iterrows():
    print(f"\nQ: {row['question'][:100]}...")
    print(f"A (wrong): {row['greedy_answer']}")
    print(f"E: {row['explanation'][:200]}...")
    print(f"Support score: {row['support_score']:.0f}")
    print(f"Support reason: {row['support_reason']}")

# =====================================================
# SAVE SUMMARY
# =====================================================

summary_df = pd.DataFrame([{
    "model": INPUT_CSV.split("/")[-1].replace("generations_", "").replace("_v2.csv", ""),
    "n_scored": len(scored),
    "support_correct": correct_support.mean(),
    "support_incorrect": incorrect_support.mean(),
    "tce": tce,
    "mannwhitney_p": p,
    "spearman_r": r,
    "spearman_p": rp,
}])

summary_df.to_csv(OUTPUT_CSV.replace(".csv", "_summary.csv"), index=False)
print(f"\nSummary saved to: {OUTPUT_CSV.replace('.csv', '_summary.csv')}")
