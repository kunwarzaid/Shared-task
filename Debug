"""
Scans generations_*_judged.csv OR raw generations_*.csv files for two
failure modes spotted in the ECQA diagnostic output:

1. Refusals -- the model declined to answer/explain at all (seen in
   Llama-Instruct's shortest example: "I can't provide information...").
2. Degenerate repetition -- the model wandered into fake continued
   Q&A pairs instead of explaining (seen throughout Mistral-7B-v0.1's
   shortest examples). Detected via repeated "Q:"/"Question:" markers
   within a single explanation, which should never appear at all in a
   well-formed single explanation.

Run this BEFORE any judge scoring or regeneration decisions -- it's
nearly free and determines the real scope of problems that eyeballing
3 shortest examples per file can't reveal.
"""
import argparse
import glob
import re
import pandas as pd

REFUSAL_PATTERNS = [
    r"\bi can'?t\b", r"\bi cannot\b", r"\bi'?m sorry\b", r"\bi am sorry\b",
    r"\bas an ai\b", r"\bi don'?t have\b", r"\bi'?m not able\b",
    r"\bi'?m unable\b", r"\bi apologize\b",
]
REFUSAL_RE = re.compile("|".join(REFUSAL_PATTERNS), re.IGNORECASE)

FAKE_QA_RE = re.compile(r"\n\s*(Q:|Question:)", re.IGNORECASE)


def scan_column(df, col):
    texts = df[col].fillna("")
    n_total = len(texts)
    n_empty = (texts.str.strip() == "").sum()

    is_refusal = texts.str.contains(REFUSAL_RE)
    n_refusal = is_refusal.sum()

    fake_qa_count = texts.apply(lambda t: len(FAKE_QA_RE.findall(t)))
    n_degenerate = (fake_qa_count > 0).sum()

    # exact-duplicate-sentence check, cheap proxy for repetition loops
    def has_repeated_sentence(t):
        sentences = [s.strip() for s in re.split(r"(?<=[.!?])\s+", t) if len(s.strip()) > 15]
        return len(sentences) != len(set(sentences))
    n_repeated_sentence = texts.apply(has_repeated_sentence).sum()

    return {
        "column": col,
        "n_total": n_total,
        "n_empty": int(n_empty),
        "n_refusal": int(n_refusal),
        "n_degenerate_fake_qa": int(n_degenerate),
        "n_repeated_sentence": int(n_repeated_sentence),
        "refusal_examples": df.loc[is_refusal, col].head(2).tolist(),
        "degenerate_examples": df.loc[fake_qa_count > 0, col].head(2).tolist(),
    }


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--pattern", default="generations_ecqa_*.csv")
    args = parser.parse_args()

    candidates = sorted(glob.glob(args.pattern))
    files = [f for f in candidates if "_judged" not in f]

    explanation_cols = ["explanation_justificatory", "explanation_assessment"]

    summary_rows = []
    for path in files:
        df = pd.read_csv(path)
        print(f"\n{'='*70}\n{path}\n{'='*70}")
        for col in explanation_cols:
            if col not in df.columns:
                continue
            result = scan_column(df, col)
            print(f"\n[{col}] total={result['n_total']} empty={result['n_empty']} "
                  f"refusals={result['n_refusal']} "
                  f"degenerate_fake_qa={result['n_degenerate_fake_qa']} "
                  f"repeated_sentence={result['n_repeated_sentence']}")
            if result["n_refusal"] > 0:
                print(f"  refusal example: {result['refusal_examples'][0][:150]!r}")
            if result["n_degenerate_fake_qa"] > 0:
                print(f"  degenerate example: {result['degenerate_examples'][0][:150]!r}")
            summary_rows.append({"file": path, **result})

    if summary_rows:
        summary_df = pd.DataFrame(summary_rows).drop(columns=["refusal_examples", "degenerate_examples"])
        print(f"\n{'='*70}\nSUMMARY (all files, all columns)\n{'='*70}")
        print(summary_df.to_string(index=False))
        total_flagged = summary_df[["n_refusal", "n_degenerate_fake_qa", "n_repeated_sentence"]].sum().sum()
        print(f"\nTotal flagged instances across all files/columns: {int(total_flagged)}")
        print("Non-zero rows above are what determines whether this needs targeted "
              "regeneration, a stricter stop condition, or is rare enough to exclude "
              "row-by-row before judge scoring.")


if __name__ == "__main__":
    main()
