import os
import torch
import numpy as np
import pandas as pd
from tqdm import tqdm
from datasets import load_dataset
from transformers import AutoTokenizer, AutoModelForCausalLM
from huggingface_hub import login
# =====================================================
# CONFIG
# =====================================================
HF_TOKEN = ''
MODEL_NAME = "meta-llama/Llama-3.1-8B"
MODEL_SHORT = MODEL_NAME.split("/")[-1]
IS_BASE_MODEL = "Instruct" not in MODEL_NAME
BASE_DIR = "/workspace/data/KZ_2117574/Calibration/medqa_closed_form"
OUTPUT_DIR = os.path.join(BASE_DIR, f"results_{MODEL_SHORT}")
os.makedirs(OUTPUT_DIR, exist_ok=True)
OUTPUT_CSV = os.path.join(OUTPUT_DIR, "generations_closed_form.csv")
PILOT_SIZE = 200
OPTION_LETTERS = ["A", "B", "C", "D", "E"]
print(f"Model: {MODEL_NAME} | Closed-form entropy | Is base: {IS_BASE_MODEL}")
# =====================================================
# LOGIN + MODEL
# =====================================================
login(token=HF_TOKEN)
print("Loading tokenizer...")
tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME, trust_remote_code=True)
if tokenizer.pad_token is None:
   tokenizer.pad_token = tokenizer.eos_token
print("Loading model...")
model = AutoModelForCausalLM.from_pretrained(
   MODEL_NAME, torch_dtype=torch.float16,
   device_map="auto", trust_remote_code=True
)
model.eval()
print("Model loaded.")
# =====================================================
# IDENTIFY THE TOKEN IDS FOR EACH OPTION LETTER
# Different tokenizers may represent "A" differently depending on
# whether it is preceded by a space; we check both variants and use
# whichever the tokenizer actually produces as a single token, since
# the letter will typically appear after "Answer: " in our prompt
# (i.e., with a preceding space).
# =====================================================
def get_letter_token_ids(tokenizer):
   """
   Returns a dict {letter: token_id} for the five option letters,
   using the tokenization that arises when the letter follows a
   space (the expected context in our prompt template).
   """
   letter_ids = {}
   for letter in OPTION_LETTERS:
       # Tokenize " A" and take the last token, which is what the
       # model would actually produce as the next token after
       # "Answer: " in context.
       ids = tokenizer.encode(f" {letter}", add_special_tokens=False)
       letter_ids[letter] = ids[-1]
   return letter_ids
LETTER_TOKEN_IDS = get_letter_token_ids(tokenizer)
print(f"Option letter token IDs: {LETTER_TOKEN_IDS}")
# Sanity check: verify these token IDs decode back to single letters
for letter, tid in LETTER_TOKEN_IDS.items():
   decoded = tokenizer.decode([tid])
   print(f"  {letter} -> token id {tid} -> decodes as {decoded!r}")
# =====================================================
# CHAT TEMPLATE HELPER
# =====================================================
def build_prompt(user_message):
   if tokenizer.chat_template is not None and not IS_BASE_MODEL:
       messages = [{"role": "user", "content": user_message}]
       prompt = tokenizer.apply_chat_template(
           messages, tokenize=False, add_generation_prompt=True
       )
   else:
       prompt = user_message
   return prompt
def format_medqa_question(item):
   options_text = "\n".join(
       f"{opt['key']}. {opt['value']}" for opt in item["options"]
   )
   return f"{item['question']}\n\n{options_text}"
def get_option_text(item, letter):
   for opt in item["options"]:
       if opt["key"] == letter:
           return opt["value"]
   return None
# =====================================================
# CLOSED-FORM ENTROPY COMPUTATION
# =====================================================
def compute_closed_form_uhat(item):
   """
   Runs a single forward pass up to the point immediately before the
   model would generate the answer letter, extracts the logits at
   that position, restricts to the five option-letter tokens,
   renormalizes to a valid probability distribution over exactly
   those five outcomes, and computes exact Shannon entropy.
   """
   question_formatted = format_medqa_question(item)
   if IS_BASE_MODEL:
       user_message = f"Q: {question_formatted}\nA:"
   else:
       user_message = (
           f"Answer the following medical question by selecting "
           f"the single best option (A, B, C, D, or E).\n\n"
           f"{question_formatted}\n\nAnswer:"
       )
   prompt = build_prompt(user_message)
   inputs = tokenizer(
       prompt, return_tensors="pt", truncation=True, max_length=1536
   ).to(model.device)
   with torch.no_grad():
       outputs = model(**inputs)
       # Logits at the final position: what the model would produce
       # as the very next token (the answer letter, in our prompt design)
       next_token_logits = outputs.logits[0, -1, :]
   # Extract logits for exactly the five option-letter tokens
   letter_logits = torch.tensor([
       next_token_logits[LETTER_TOKEN_IDS[letter]].item()
       for letter in OPTION_LETTERS
   ])
   # Softmax over just these five logits -- this is the model's
   # probability distribution over the five options specifically,
   # renormalized (not the full-vocabulary softmax, which would
   # place most mass on non-letter tokens like whitespace).
   probs = torch.softmax(letter_logits, dim=0).numpy()
   # Exact Shannon entropy, normalized by log(5)
   epsilon = 1e-12
   entropy = -np.sum(probs * np.log(probs + epsilon))
   max_entropy = np.log(5)
   norm_uhat = entropy / max_entropy
   # Greedy answer: argmax over the five option probabilities
   greedy_idx = int(np.argmax(probs))
   greedy_letter = OPTION_LETTERS[greedy_idx]
   return greedy_letter, probs, entropy, norm_uhat
def get_explanation(item, answer_letter, answer_text):
   question_formatted = format_medqa_question(item)
   if IS_BASE_MODEL:
       user_message = (
           f"Q: {question_formatted}\n"
           f"A: {answer_letter}. {answer_text}\n"
           f"This is because"
       )
   else:
       user_message = (
           f"Question: {question_formatted}\n\n"
           f"Answer: {answer_letter}. {answer_text}\n\n"
           f"Provide an explanation for this answer:"
       )
   prompt = build_prompt(user_message)
   inputs = tokenizer(
       prompt, return_tensors="pt", truncation=True, max_length=1536
   ).to(model.device)
   with torch.no_grad():
       output = model.generate(
           **inputs, max_new_tokens=250, do_sample=False,
           pad_token_id=tokenizer.pad_token_id,
           eos_token_id=tokenizer.eos_token_id
       )
   generated_tokens = output[0][inputs.input_ids.shape[1]:]
   explanation = tokenizer.decode(generated_tokens, skip_special_tokens=True).strip()
   return explanation
# =====================================================
# LOAD DATASET
# =====================================================
print("\nLoading MedQA...")
dataset = load_dataset("bigbio/med_qa", "med_qa_en_source")
split_name = "test" if "test" in dataset else list(dataset.keys())[0]
questions = list(dataset[split_name])[:PILOT_SIZE]
print(f"Loaded {len(questions)} questions from split '{split_name}'.")
# =====================================================
# MAIN LOOP
# =====================================================
rows = []
for idx, item in enumerate(tqdm(questions)):
   correct_letter = item["answer_idx"]
   print(f"\n[{idx:03d}/{len(questions)}] {item['question'][:70]}...")
   try:
       (
           greedy_letter, probs, entropy, norm_uhat
       ) = compute_closed_form_uhat(item)
       answer_text = get_option_text(item, greedy_letter)
       correct = int(greedy_letter == correct_letter)
       explanation = get_explanation(item, greedy_letter, answer_text)
       prob_str = ", ".join(f"{l}={p:.3f}" for l, p in zip(OPTION_LETTERS, probs))
       print(
           f"  U_hat={norm_uhat:.4f} | probs=[{prob_str}] | "
           f"pred={greedy_letter} | true={correct_letter} | correct={correct}"
       )
       rows.append({
           "model": MODEL_SHORT,
           "condition": "closed_form",
           "dataset": "medqa",
           "question": item["question"],
           "options": str(item["options"]),
           "prob_A": probs[0], "prob_B": probs[1], "prob_C": probs[2],
           "prob_D": probs[3], "prob_E": probs[4],
           "predicted_letter": greedy_letter,
           "greedy_answer": answer_text,
           "explanation": explanation,
           "correct_letter": correct_letter,
           "correct": correct,
           "entropy": entropy,
           "norm_uhat": norm_uhat,
       })
   except Exception as e:
       print(f"  ERROR: {e}")
       rows.append({
           "model": MODEL_SHORT, "condition": "closed_form", "dataset": "medqa",
           "question": item["question"], "options": str(item["options"]),
           "prob_A": None, "prob_B": None, "prob_C": None,
           "prob_D": None, "prob_E": None,
           "predicted_letter": None, "greedy_answer": None,
           "explanation": None, "correct_letter": correct_letter,
           "correct": None, "entropy": None, "norm_uhat": None,
       })
   if idx % 10 == 0:
       pd.DataFrame(rows).to_csv(OUTPUT_CSV, index=False)
df = pd.DataFrame(rows)
df.to_csv(OUTPUT_CSV, index=False)
valid = df[df["norm_uhat"].notna()]
correct_df = valid[valid["correct"] == 1]
incorrect_df = valid[valid["correct"] == 0]
print(f"\n{'='*60}")
print(f"CLOSED-FORM MEDQA SUMMARY: {MODEL_SHORT}")
print(f"{'='*60}")
print(f"Total: {len(df)} | Valid: {len(valid)}")
print(f"Correct: {len(correct_df)} | Incorrect: {len(incorrect_df)}")
if len(correct_df) > 0 and len(incorrect_df) > 0:
   print(f"U_hat correct:   mean={correct_df['norm_uhat'].mean():.4f}  sd={correct_df['norm_uhat'].std():.4f}")
   print(f"U_hat incorrect: mean={incorrect_df['norm_uhat'].mean():.4f}  sd={incorrect_df['norm_uhat'].std():.4f}")
# Variance diagnostics the reviewer specifically asked for
print(f"\n--- Variance diagnostics ---")
print(f"Overall SD of U_hat: {valid['norm_uhat'].std():.4f}")
print(f"Fraction with U_hat < 0.01 (near-floor): {(valid['norm_uhat'] < 0.01).mean():.1%}")
print(f"Fraction with U_hat > 0.99 (near-ceiling): {(valid['norm_uhat'] > 0.99).mean():.1%}")
print(f"Number of distinct U_hat values (rounded to 4dp): {valid['norm_uhat'].round(4).nunique()}")
print(f"\nSaved to: {OUTPUT_CSV}")
