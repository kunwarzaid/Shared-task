import os
import gc
import re
import torch
import numpy as np
import pandas as pd
from tqdm import tqdm
from datasets import load_dataset
from transformers import AutoTokenizer, AutoModelForCausalLM
from huggingface_hub import login

# =====================================================
# CONFIG
# =====================================================
HF_TOKEN = ''

MODEL_CONFIGS = [
    "meta-llama/Llama-3.1-8B",
    "meta-llama/Llama-3.1-8B-Instruct",
    "mistralai/Mistral-7B-v0.1",
    "mistralai/Mistral-7B-Instruct-v0.3",
    "Qwen/Qwen2.5-7B",
    "Qwen/Qwen2.5-7B-Instruct",
]

BASE_DIR = "/workspace/data/KZ_2117574/Calibration/medmcqa_closed_form"
os.makedirs(BASE_DIR, exist_ok=True)

PILOT_SIZE = 200  # test split has 6150 rows -- plenty of headroom
OPTION_LETTERS = ["A", "B", "C", "D"]  # MedMCQA is 4-way, unlike MedQA/ECQA's 5-way
COP_TO_LETTER = {0: "A", 1: "B", 2: "C", 3: "D"}  # confirmed 0-indexed from the dataset card
CHECKPOINT_EVERY = 10

login(token=HF_TOKEN)

# =====================================================
# MEDMCQA-SPECIFIC FORMATTING
# =====================================================
def get_item_options(item):
    return {"A": item["opa"], "B": item["opb"], "C": item["opc"], "D": item["opd"]}


def get_correct_letter(item):
    return COP_TO_LETTER[item["cop"]]


def format_medmcqa_question(item):
    options = get_item_options(item)
    options_text = "\n".join(f"{letter}. {options[letter]}" for letter in OPTION_LETTERS)
    return f"{item['question']}\n\n{options_text}"


def get_option_text(item, letter):
    return get_item_options(item).get(letter)


def get_gold_explanation(item, chosen_letter, correct_letter):
    """
    Unlike ECQA/MedExpQA, MedMCQA's 'exp' field explains only the
    CORRECT answer -- there is no refutation of incorrect options at
    all. When the model is wrong, there is no gold text available,
    full stop (not even a combined/imprecise one like ECQA's
    taskA_neg). This is recorded explicitly rather than left implicit.
    """
    if chosen_letter == correct_letter:
        text = item.get("exp", "") or ""
        return ("exp" if text.strip() else "NONE_EMPTY_FIELD"), text
    else:
        return "NONE_NO_NEGATIVE_EXPLANATIONS_EXIST", ""


# =====================================================
# Truncate on fake-continuation markers (same fix applied to the ECQA
# script after Mistral-7B-v0.1 was found drifting into hallucinated
# new Q&A pairs 94% of the time on that dataset). Built in from the
# start here rather than retrofitted.
# =====================================================
FAKE_CONTINUATION_RE = re.compile(r"\n\s*(Q:|Question:)", re.IGNORECASE)


def clean_explanation(text):
    match = FAKE_CONTINUATION_RE.search(text)
    if match:
        return text[:match.start()].strip()
    return text.strip()


# =====================================================
# LOAD DATASET
# =====================================================
print("Loading MedMCQA...")
dataset = load_dataset("openlifescienceai/medmcqa")
pooled = dataset["test"]
print(f"Test split: {len(pooled)} rows")

# Filter to single-answer questions only -- 'multi' choice_type items
# don't fit a single-greedy-letter methodology and would silently
# corrupt correctness labels if treated the same way.
all_items = list(pooled)
single_items = [item for item in all_items if item.get("choice_type") == "single"]
n_multi_excluded = len(all_items) - len(single_items)
print(f"Excluded {n_multi_excluded} multi-answer items (choice_type != 'single').")
print(f"{len(single_items)} single-answer items remain.")

QUESTIONS = single_items[:PILOT_SIZE] if PILOT_SIZE is not None else single_items
print(f"Using {len(QUESTIONS)} questions for every model in this run.\n")

# =====================================================
# PRE-GENERATION DIAGNOSTIC: exp-field coverage
# Confirms actual coverage before committing compute -- this was
# flagged as unconfirmed when MedMCQA was first proposed as a
# candidate dataset, never actually checked until now.
# =====================================================
print("--- Pre-generation 'exp' field coverage check ---")
n_with_exp = sum(1 for item in QUESTIONS if (item.get("exp") or "").strip())
print(f"{n_with_exp}/{len(QUESTIONS)} items ({n_with_exp/len(QUESTIONS):.1%}) have a "
      f"non-empty 'exp' field for their correct answer.")
print("Remember: this is coverage for the CORRECT option only. A model that answers "
      "incorrectly on one of these items still gets NO gold explanation at all -- "
      "MedMCQA's Ce-eligible fraction will be lower than this number once real "
      "model accuracy is factored in (accuracy% x exp-coverage%, roughly).")
print("--- End check ---\n")


# =====================================================
# PER-MODEL RUN (same structure as the current ECQA script)
# =====================================================
def variant_str(model_name):
    return "instruct" if "Instruct" in model_name else "base"


def output_path_for(model_name):
    model_short = model_name.split("/")[-1]
    variant = variant_str(model_name)
    return os.path.join(BASE_DIR, f"generations_medmcqa_{model_short}_{variant}.csv")


def load_resume_state(output_csv, target_n):
    if not os.path.exists(output_csv):
        return [], 0, False
    existing_df = pd.read_csv(output_csv)
    n_existing = len(existing_df)
    if n_existing >= target_n:
        return existing_df.to_dict("records"), n_existing, True
    return existing_df.to_dict("records"), n_existing, False


def run_for_model(model_name):
    model_short = model_name.split("/")[-1]
    is_base_model = "Instruct" not in model_name
    variant = variant_str(model_name)
    output_csv = output_path_for(model_name)

    print(f"\n{'='*70}\nMODEL: {model_name}  (variant={variant})\nOutput: {output_csv}\n{'='*70}")

    rows, start_idx, already_complete = load_resume_state(output_csv, len(QUESTIONS))
    if already_complete:
        print(f"SKIPPING -- output already has {len(rows)}/{len(QUESTIONS)} rows (complete).")
        return
    if start_idx > 0:
        print(f"RESUMING from item {start_idx}/{len(QUESTIONS)}.")
    else:
        print(f"Starting fresh: 0/{len(QUESTIONS)} rows exist yet.")

    print("Loading tokenizer...")
    tokenizer = AutoTokenizer.from_pretrained(model_name, trust_remote_code=True)
    if tokenizer.pad_token is None:
        tokenizer.pad_token = tokenizer.eos_token
    print("Loading model...")
    model = AutoModelForCausalLM.from_pretrained(
        model_name, torch_dtype=torch.float16,
        device_map="auto", trust_remote_code=True
    )
    model.eval()
    print("Model loaded.")

    letter_token_ids = {}
    for letter in OPTION_LETTERS:
        ids = tokenizer.encode(f" {letter}", add_special_tokens=False)
        letter_token_ids[letter] = ids[-1]
    print(f"Option letter token IDs: {letter_token_ids}")

    def build_prompt(user_message):
        if tokenizer.chat_template is not None and not is_base_model:
            messages = [{"role": "user", "content": user_message}]
            return tokenizer.apply_chat_template(
                messages, tokenize=False, add_generation_prompt=True
            )
        return user_message

    def compute_closed_form_uhat(item):
        question_formatted = format_medmcqa_question(item)
        if is_base_model:
            user_message = f"Q: {question_formatted}\nA:"
        else:
            user_message = (
                f"Answer the following medical question by selecting "
                f"the single best option (A, B, C, or D).\n\n"
                f"{question_formatted}\n\nAnswer:"
            )
        prompt = build_prompt(user_message)
        inputs = tokenizer(
            prompt, return_tensors="pt", truncation=True, max_length=1536
        ).to(model.device)
        with torch.no_grad():
            outputs = model(**inputs)
            next_token_logits = outputs.logits[0, -1, :]
        letter_logits = torch.tensor([
            next_token_logits[letter_token_ids[letter]].item()
            for letter in OPTION_LETTERS
        ])
        probs = torch.softmax(letter_logits, dim=0).numpy()
        epsilon = 1e-12
        entropy = -np.sum(probs * np.log(probs + epsilon))
        norm_uhat = entropy / np.log(4)  # 4-way, not 5-way -- log(4) not log(5)
        greedy_idx = int(np.argmax(probs))
        greedy_letter = OPTION_LETTERS[greedy_idx]
        return greedy_letter, probs, entropy, norm_uhat

    def get_explanation(item, answer_letter, answer_text, style):
        question_formatted = format_medmcqa_question(item)
        if is_base_model:
            if style == "justificatory":
                user_message = (
                    f"Q: {question_formatted}\n"
                    f"A: {answer_letter}. {answer_text}\n"
                    f"This is because"
                )
            else:  # "assessment" -- uses the fixed prompt shape from the start
                user_message = (
                    f"Q: {question_formatted}\n"
                    f"A: {answer_letter}. {answer_text}\n"
                    f"Is this answer correct? I am"
                )
        else:
            if style == "justificatory":
                user_message = (
                    f"Question: {question_formatted}\n\n"
                    f"Answer: {answer_letter}. {answer_text}\n\n"
                    f"Provide an explanation for this answer:"
                )
            else:  # "assessment"
                user_message = (
                    f"Question: {question_formatted}\n\n"
                    f"Answer: {answer_letter}. {answer_text}\n\n"
                    f"Assess whether this answer is correct, and explain your assessment. "
                    f"If you are uncertain whether the answer is correct, say so explicitly and explain why."
                )
        prompt = build_prompt(user_message)
        inputs = tokenizer(
            prompt, return_tensors="pt", truncation=True, max_length=1536
        ).to(model.device)
        with torch.no_grad():
            output = model.generate(
                **inputs, max_new_tokens=250, do_sample=False,
                pad_token_id=tokenizer.pad_token_id,
                eos_token_id=tokenizer.eos_token_id
            )
        generated_tokens = output[0][inputs.input_ids.shape[1]:]
        raw_explanation = tokenizer.decode(generated_tokens, skip_special_tokens=True)
        return clean_explanation(raw_explanation)

    for idx in tqdm(range(start_idx, len(QUESTIONS)), initial=start_idx, total=len(QUESTIONS)):
        item = QUESTIONS[idx]
        print(f"\n[{idx:03d}/{len(QUESTIONS)}] {item['question'][:70]}...")

        try:
            correct_letter = get_correct_letter(item)
            greedy_letter, probs, entropy, norm_uhat = compute_closed_form_uhat(item)
            answer_text = get_option_text(item, greedy_letter)
            correct = int(greedy_letter == correct_letter)
            gold_source, gold_text = get_gold_explanation(item, greedy_letter, correct_letter)
            prob_str = ", ".join(f"{l}={p:.3f}" for l, p in zip(OPTION_LETTERS, probs))
            print(f"  U_hat={norm_uhat:.4f} | probs=[{prob_str}] | "
                  f"pred={greedy_letter} | true={correct_letter} | correct={correct}")
        except Exception as e:
            print(f"  ERROR (confidence step): {e}")
            rows.append({
                "model": model_short, "condition": "closed_form", "dataset": "medmcqa",
                "question": item.get("question"), "subject_name": item.get("subject_name"),
                "topic_name": item.get("topic_name"),
                "options": None,
                "prob_A": None, "prob_B": None, "prob_C": None, "prob_D": None,
                "predicted_letter": None, "greedy_answer": None,
                "explanation_justificatory": None, "explanation_assessment": None,
                "correct_letter": None, "correct": None,
                "entropy": None, "norm_uhat": None,
                "gold_explanation_source": None, "gold_explanation_text": None,
            })
            if idx % CHECKPOINT_EVERY == 0:
                pd.DataFrame(rows).to_csv(output_csv, index=False)
            continue

        try:
            explanation_justificatory = get_explanation(item, greedy_letter, answer_text, style="justificatory")
            explanation_assessment = get_explanation(item, greedy_letter, answer_text, style="assessment")
        except Exception as e:
            print(f"  ERROR (explanation step): {e}")
            explanation_justificatory = None
            explanation_assessment = None

        rows.append({
            "model": model_short,
            "condition": "closed_form",
            "dataset": "medmcqa",
            "question": item["question"],
            "subject_name": item.get("subject_name"),
            "topic_name": item.get("topic_name"),
            "options": str(get_item_options(item)),
            "prob_A": probs[0], "prob_B": probs[1], "prob_C": probs[2], "prob_D": probs[3],
            "predicted_letter": greedy_letter,
            "greedy_answer": answer_text,
            "explanation_justificatory": explanation_justificatory,
            "explanation_assessment": explanation_assessment,
            "correct_letter": correct_letter,
            "correct": correct,
            "entropy": entropy,
            "norm_uhat": norm_uhat,
            "gold_explanation_source": gold_source,
            "gold_explanation_text": gold_text,
        })

        if idx % CHECKPOINT_EVERY == 0:
            pd.DataFrame(rows).to_csv(output_csv, index=False)

    df = pd.DataFrame(rows)
    df.to_csv(output_csv, index=False)

    valid = df[df["norm_uhat"].notna()]
    correct_df = valid[valid["correct"] == 1]
    incorrect_df = valid[valid["correct"] == 0]
    print(f"\n{'='*60}\nCLOSED-FORM MEDMCQA SUMMARY: {model_short} ({variant})\n{'='*60}")
    print(f"Total: {len(df)} | Valid: {len(valid)}")
    print(f"Correct: {len(correct_df)} | Incorrect: {len(incorrect_df)}")
    if len(correct_df) > 0 and len(incorrect_df) > 0:
        print(f"U_hat correct:   mean={correct_df['norm_uhat'].mean():.4f}  sd={correct_df['norm_uhat'].std():.4f}")
        print(f"U_hat incorrect: mean={incorrect_df['norm_uhat'].mean():.4f}  sd={incorrect_df['norm_uhat'].std():.4f}")

    ce_eligible = valid[valid["gold_explanation_source"] == "exp"]
    print(f"\nAchieved Ce-eligible rows (correct AND exp non-empty): "
          f"{len(ce_eligible)}/{len(valid)} ({len(ce_eligible)/max(len(valid),1):.1%})")
    print(f"Saved to: {output_csv}")

    del model
    del tokenizer
    gc.collect()
    torch.cuda.empty_cache()


for model_name in MODEL_CONFIGS:
    run_for_model(model_name)

print("\nAll model variants processed.")
