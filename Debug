# ============================================================
# 8. RANK-BISERIAL EFFECT SIZE
# ============================================================

def rank_biserial(
    correct_scores,
    incorrect_scores,
):

    c = np.asarray(
        correct_scores,
        dtype=float,
    )

    i = np.asarray(
        incorrect_scores,
        dtype=float,
    )

    if len(c) == 0 or len(i) == 0:
        return np.nan

    U = mannwhitneyu(
        c,
        i,
        alternative="two-sided",
    ).statistic

    # Positive:
    # correct > incorrect
    #
    # Negative:
    # incorrect > correct

    return (
        (2 * U) /
        (len(c) * len(i))
        - 1
    )


def bootstrap_rank_biserial_ci(
    correct_scores,
    incorrect_scores,
):

    c = np.asarray(
        correct_scores,
        dtype=float,
    )

    i = np.asarray(
        incorrect_scores,
        dtype=float,
    )

    rng = np.random.default_rng(SEED)

    values = []

    for _ in range(N_BOOT):

        cb = rng.choice(
            c,
            size=len(c),
            replace=True,
        )

        ib = rng.choice(
            i,
            size=len(i),
            replace=True,
        )

        effect = rank_biserial(
            cb,
            ib,
        )

        if np.isfinite(effect):
            values.append(effect)

    if not values:
        return np.nan, np.nan, 0

    values = np.asarray(values)

    return (
        np.percentile(values, 2.5),
        np.percentile(values, 97.5),
        len(values),
    )


