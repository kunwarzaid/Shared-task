"""
Scores a generations_*.csv file (from generate_ecqa_closed_form.py or
the MedExpQA equivalent) with two judges:

1. Uncertainty judge -- how certain does the explanation's LANGUAGE
   sound, 0-100. Reused verbatim from the EACL pipeline (already
   validated against humans at rho=0.709 on MedQA/StrategyQA -- that
   validation has NOT been re-confirmed on this dataset; consider a
   spot-check before trusting it fully here).

2. Ce judge -- does the explanation's REASONING match the gold
   explanation for the chosen option, 0-100. New, drafted for this
   project, UNVALIDATED. Run VALIDATION_MODE first on a small sample
   and compare against your own judgment before scoring at scale.

Both judges run on BOTH explanation columns (justificatory and
assessment) separately, so elicitation-framing effects on each
construct can be compared, not conflated.

Ce is only computed for rows with non-empty gold_explanation_text --
scored as null otherwise, not silently skipped without a trace.
"""
import os
import json
import time
import argparse
import pandas as pd
from openai import OpenAI  # swap for your actual judge-model client if different

client = OpenAI(api_key=os.environ.get("OPENAI_API_KEY", ""))
JUDGE_MODEL = "gpt-4o"  # set to whatever GPT-4/5-class judge model you used in EACL
CHECKPOINT_EVERY = 10
MAX_RETRIES = 3

# =====================================================
# JUDGE PROMPTS
# =====================================================
UNCERTAINTY_SYSTEM_PROMPT = """You are an expert evaluator assessing
how much uncertainty is communicated in natural language explanations
generated by an AI model.

IMPORTANT: You are evaluating PERCEIVED uncertainty communicated to
a reader.

Do NOT evaluate: whether the explanation is factually correct;
whether the answer is actually uncertain; whether alternative
answers may exist; whether the model should be uncertain.

Evaluate ONLY how uncertain the explanation SOUNDS.

Score from 0 to 100: 0 = completely certain, 100 = extremely uncertain.

Return ONLY valid JSON:
{"uncertainty_score": <integer 0-100>, "reason": "<one sentence>"}"""

def uncertainty_user_prompt(question, answer, explanation):
    return f"""Question: {question}
Answer: {answer}
Explanation: {explanation}

Evaluate how much uncertainty is communicated in the explanation
above. Respond with a JSON object in exactly this format:
{{"uncertainty_score": <integer 0-100>, "reason": "<one sentence explaining your score>"}}
Return only the JSON object. No other text."""


CE_SYSTEM_PROMPT = """You are an expert evaluator comparing a
model-generated explanation against a gold-standard explanation for
one specific answer option.

IMPORTANT: You are evaluating whether the model's explanation
reflects the same REASONING as the gold explanation for this specific
option -- not whether the option itself is the correct answer to the
question, and not the writing quality, fluency, or length of the
explanation.

Do NOT evaluate: whether the chosen option is correct; how well the
explanation is written; how confident or hedged the explanation
sounds.

Evaluate ONLY whether the reasoning in the model's explanation
matches the reasoning in the gold explanation for this option.

Score from 0 to 100: 0 = the model's explanation reflects entirely
different, absent, or contradictory reasoning from the gold
explanation; 100 = the model's explanation captures the same key
reasoning as the gold explanation, even if worded differently.

Return ONLY valid JSON:
{"explanation_correctness_score": <integer 0-100>, "reason": "<one sentence>"}"""

def ce_user_prompt(question, option_text, gold_explanation, model_explanation, gold_is_combined_negative):
    coverage_note = (
        "\nNOTE: this gold explanation is a COMBINED passage addressing "
        "multiple incorrect options together, not isolated to this one "
        "specific option -- judge whether the model's reasoning matches "
        "the portion of the gold text relevant to this option."
        if gold_is_combined_negative else ""
    )
    return f"""Question: {question}

Answer option being explained: {option_text}

Gold explanation for this option: {gold_explanation}{coverage_note}

Model-generated explanation: {model_explanation}

Evaluate how well the model's explanation captures the same reasoning
as the gold explanation above. Respond with a JSON object in exactly
this format:
{{"explanation_correctness_score": <integer 0-100>, "reason": "<one sentence explaining your score>"}}
Return only the JSON object. No other text."""


# =====================================================
# JUDGE CALL WRAPPER (shared, with retries)
# =====================================================
def call_judge(system_prompt, user_prompt, score_key):
    for attempt in range(MAX_RETRIES):
        try:
            response = client.chat.completions.create(
                model=JUDGE_MODEL,
                messages=[
                    {"role": "system", "content": system_prompt},
                    {"role": "user", "content": user_prompt},
                ],
                temperature=0,
                response_format={"type": "json_object"},
            )
            content = response.choices[0].message.content
            parsed = json.loads(content)
            return parsed.get(score_key), parsed.get("reason", "")
        except Exception as e:
            print(f"    judge call failed (attempt {attempt+1}/{MAX_RETRIES}): {e}")
            time.sleep(2 ** attempt)
    return None, "JUDGE_CALL_FAILED"


# =====================================================
# MAIN SCORING LOOP
# =====================================================
def score_file(input_csv, output_csv, validation_mode=False, validation_n=30):
    df = pd.read_csv(input_csv)

    if validation_mode:
        df = df.sample(n=min(validation_n, len(df)), random_state=42).reset_index(drop=True)
        print(f"VALIDATION MODE: scoring {len(df)} randomly sampled rows only. "
              f"Compare these against your own judgment before running at scale.")

    # resume: load existing scored output if present
    if os.path.exists(output_csv):
        existing = pd.read_csv(output_csv)
        start_idx = len(existing)
        results = existing.to_dict("records")
        if start_idx >= len(df):
            print(f"SKIPPING -- {output_csv} already has {start_idx}/{len(df)} rows scored (complete).")
            return
        print(f"Resuming from row {start_idx}/{len(df)} (found existing {output_csv})")
    else:
        start_idx = 0
        results = []

    for idx in range(start_idx, len(df)):
        row = df.iloc[idx]
        print(f"[{idx+1}/{len(df)}] scoring row...")

        result = row.to_dict()

        for col in ["explanation_justificatory", "explanation_assessment"]:
            explanation = row.get(col)
            if pd.isna(explanation) or str(explanation).strip() == "":
                result[f"uncertainty_score_{col}"] = None
                result[f"uncertainty_reason_{col}"] = "SKIPPED_EMPTY_EXPLANATION"
                result[f"ce_score_{col}"] = None
                result[f"ce_reason_{col}"] = "SKIPPED_EMPTY_EXPLANATION"
                continue

            # ---- Uncertainty judge ----
            u_score, u_reason = call_judge(
                UNCERTAINTY_SYSTEM_PROMPT,
                uncertainty_user_prompt(row["question"], row["greedy_answer"], explanation),
                "uncertainty_score",
            )
            result[f"uncertainty_score_{col}"] = u_score
            result[f"uncertainty_reason_{col}"] = u_reason

            # ---- Ce judge (only if gold explanation text exists) ----
            gold_text = row.get("gold_explanation_text")
            if pd.isna(gold_text) or str(gold_text).strip() == "":
                result[f"ce_score_{col}"] = None
                result[f"ce_reason_{col}"] = "NO_GOLD_EXPLANATION_AVAILABLE"
            else:
                ce_score, ce_reason = call_judge(
                    CE_SYSTEM_PROMPT,
                    ce_user_prompt(
                        row["question"], row["greedy_answer"], gold_text, explanation,
                        gold_is_combined_negative=bool(row.get("gold_explanation_is_combined_negative", False)),
                    ),
                    "explanation_correctness_score",
                )
                result[f"ce_score_{col}"] = ce_score
                result[f"ce_reason_{col}"] = ce_reason

        results.append(result)

        if (idx + 1) % CHECKPOINT_EVERY == 0:
            pd.DataFrame(results).to_csv(output_csv, index=False)

    pd.DataFrame(results).to_csv(output_csv, index=False)
    print(f"\nDone. Saved to {output_csv}")

    # quick summary
    out_df = pd.DataFrame(results)
    for col in ["explanation_justificatory", "explanation_assessment"]:
        u = out_df[f"uncertainty_score_{col}"].dropna()
        ce = out_df[f"ce_score_{col}"].dropna()
        print(f"\n{col}:")
        print(f"  uncertainty_score: n={len(u)}, mean={u.mean():.1f}" if len(u) else "  uncertainty_score: n=0")
        print(f"  ce_score: n={len(ce)}, mean={ce.mean():.1f}" if len(ce) else "  ce_score: n=0 (no gold-covered rows scored)")


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("input_csv", nargs="?", default=None,
                         help="Score a single file (e.g. for --validation_mode testing). "
                              "Omit this to batch-score every matching file instead.")
    parser.add_argument("--pattern", default="generations_ecqa_*.csv",
                         help="Glob pattern for batch mode. Change the dataset prefix "
                              "for MedExpQA/MedMCQA, e.g. 'generations_medexpqa_*.csv'.")
    parser.add_argument("--output_csv", default=None,
                         help="Only used with a single input_csv. Batch mode always "
                              "derives output paths automatically.")
    parser.add_argument("--validation_mode", action="store_true",
                         help="Score only a small random sample, for human comparison "
                              "before scaling up. Requires a single input_csv.")
    parser.add_argument("--validation_n", type=int, default=30)
    args = parser.parse_args()

    if args.validation_mode and args.input_csv is None:
        parser.error("--validation_mode requires a single input_csv -- validate on one "
                      "file before batch-scoring all of them.")

    if args.input_csv is not None:
        # single-file mode (also covers --validation_mode)
        output_csv = args.output_csv or args.input_csv.replace(".csv", "_judged.csv")
        score_file(args.input_csv, output_csv,
                   validation_mode=args.validation_mode, validation_n=args.validation_n)
    else:
        # batch mode: loop over every file matching the pattern, skipping
        # anything already scored (name contains "_judged") so a rerun
        # doesn't try to treat prior output as new input.
        import glob
        candidates = sorted(glob.glob(args.pattern))
        input_files = [f for f in candidates if "_judged" not in f]
        skipped_as_output = [f for f in candidates if "_judged" in f]
        if skipped_as_output:
            print(f"Ignoring {len(skipped_as_output)} file(s) already matching "
                  f"'_judged' (these are prior outputs, not new inputs): {skipped_as_output}")
        if not input_files:
            print(f"No input files matched pattern {args.pattern!r} (after excluding "
                  f"already-judged outputs).")
        for input_csv in input_files:
            output_csv = input_csv.replace(".csv", "_judged.csv")
            print(f"\n{'='*70}\n{input_csv} -> {output_csv}\n{'='*70}")
            score_file(input_csv, output_csv, validation_mode=False)
        print(f"\nBatch complete: {len(input_files)} file(s) processed.")
