import os
import torch
import numpy as np
import pandas as pd
from tqdm import tqdm
from datasets import load_dataset
from transformers import AutoTokenizer, AutoModelForCausalLM
from sentence_transformers import SentenceTransformer
from sklearn.cluster import AgglomerativeClustering
from huggingface_hub import login

# =====================================================
# CONFIG — change MODEL_NAME to switch models
# =====================================================

HF_TOKEN = ''
MODEL_NAME = "meta-llama/Llama-3.1-8B-Instruct"

MODEL_SHORT = MODEL_NAME.split("/")[-1]
IS_BASE_MODEL = "Instruct" not in MODEL_NAME

BASE_DIR = "/workspace/data/KZ_2117574/Calibration/strategyqa"
OUTPUT_DIR = os.path.join(BASE_DIR, f"results_{MODEL_SHORT}")
os.makedirs(OUTPUT_DIR, exist_ok=True)
OUTPUT_CSV = os.path.join(OUTPUT_DIR, "generations.csv")

N_SAMPLES = 10
TEMPERATURE = 0.7
CLUSTER_DISTANCE_THRESHOLD = 0.15
PILOT_SIZE = 200  # StrategyQA has ~2780 questions; adjust as needed

print(f"Model: {MODEL_NAME} | Is base: {IS_BASE_MODEL}")

# =====================================================
# LOGIN + MODEL
# =====================================================

login(token=HF_TOKEN)

print("Loading tokenizer...")
tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME, trust_remote_code=True)
if tokenizer.pad_token is None:
    tokenizer.pad_token = tokenizer.eos_token

print("Loading model...")
model = AutoModelForCausalLM.from_pretrained(
    MODEL_NAME, torch_dtype=torch.float16,
    device_map="auto", trust_remote_code=True
)
model.eval()
print("Model loaded.")
print(f"EOS token: {tokenizer.eos_token} (id={tokenizer.eos_token_id})")
print(f"PAD token: {tokenizer.pad_token} (id={tokenizer.pad_token_id})")
print(f"Chat template present: {tokenizer.chat_template is not None}")

print("Loading sentence encoder...")
encoder = SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2')
print("Sentence encoder loaded.")

# =====================================================
# CHAT TEMPLATE HELPER
# =====================================================

def build_prompt(user_message):
    if tokenizer.chat_template is not None and not IS_BASE_MODEL:
        messages = [{"role": "user", "content": user_message}]
        prompt = tokenizer.apply_chat_template(
            messages, tokenize=False, add_generation_prompt=True
        )
    else:
        prompt = user_message
    return prompt

def clean_generated_text(text):
    """Cutoff if model wanders into a new Q&A pair (common in base models)."""
    for marker in ["\nQ:", "\nQuestion:"]:
        if marker in text:
            text = text.split(marker)[0].strip()
    return text

# =====================================================
# STRATEGYQA-SPECIFIC: correctness extraction
# =====================================================

def extract_yes_no(text):
    """Extract Yes/No prediction from generated text. Returns True/False/None."""
    text_lower = text.lower().strip()
    first_30 = text_lower[:30]
    if "yes" in first_30 and "no" not in first_30:
        return True
    if "no" in first_30 and "yes" not in first_30:
        return False
    # fallback: check first word only
    first_word = text_lower.split()[0].strip(".,!?") if text_lower.split() else ""
    if first_word == "yes":
        return True
    if first_word == "no":
        return False
    return None

def is_correct_strategyqa(predicted_bool, true_bool):
    if predicted_bool is None:
        return None
    return int(predicted_bool == true_bool)

# =====================================================
# FUNCTION 1: EBSE (answer sampling + entropy)
# =====================================================

def compute_ebse(question):

    if IS_BASE_MODEL:
        user_message = f"Q: {question}\nA:"
    else:
        user_message = (
            f"Answer the following question with Yes or No, "
            f"then briefly justify your answer.\n\n"
            f"Question: {question}\n\nAnswer:"
        )
    prompt = build_prompt(user_message)

    inputs = tokenizer(
        prompt, return_tensors="pt", truncation=True, max_length=1024
    ).to(model.device)

    with torch.no_grad():
        outputs = model.generate(
            **inputs, max_new_tokens=80, do_sample=True,
            temperature=TEMPERATURE, num_return_sequences=N_SAMPLES,
            pad_token_id=tokenizer.pad_token_id,
            eos_token_id=tokenizer.eos_token_id
        )

    answers = []
    for seq in outputs:
        generated = seq[inputs.input_ids.shape[1]:]
        text = tokenizer.decode(generated, skip_special_tokens=True).strip()
        text = clean_generated_text(text)
        first_line = text.split('\n')[0].strip()
        answers.append(first_line if first_line else text)

    with torch.no_grad():
        greedy_out = model.generate(
            **inputs, max_new_tokens=80, do_sample=False,
            pad_token_id=tokenizer.pad_token_id,
            eos_token_id=tokenizer.eos_token_id
        )
    greedy_tokens = greedy_out[0][inputs.input_ids.shape[1]:]
    greedy_answer = tokenizer.decode(greedy_tokens, skip_special_tokens=True).strip()
    greedy_answer = clean_generated_text(greedy_answer)
    greedy_answer = greedy_answer.split('\n')[0].strip()

    # Semantic clustering (kept for consistency with TruthfulQA pipeline,
    # even though StrategyQA answers are binary — captures phrasing diversity)
    embeddings = encoder.encode(answers)

    if len(answers) > 1:
        clustering = AgglomerativeClustering(
            n_clusters=None, distance_threshold=CLUSTER_DISTANCE_THRESHOLD,
            metric='cosine', linkage='average'
        )
        labels = clustering.fit_predict(embeddings)
    else:
        labels = np.array([0])

    n_clusters = len(set(labels))
    cluster_dict = {}
    for i, label in enumerate(labels):
        cluster_dict.setdefault(label, []).append(i)
    clusters = list(cluster_dict.values())
    cluster_probs = np.array([len(c) / N_SAMPLES for c in clusters])

    epsilon = 1e-10
    ebse = -np.sum(cluster_probs * np.log(cluster_probs + epsilon))
    max_ebse = np.log(N_SAMPLES)
    norm_ebse = ebse / max_ebse if max_ebse > 0 else 0.0
    cluster_answers = [answers[c[0]] for c in clusters]

    return greedy_answer, answers, ebse, norm_ebse, n_clusters, cluster_answers

# =====================================================
# FUNCTION 2: Explanation
# =====================================================

def get_explanation(question, answer):

    if IS_BASE_MODEL:
        user_message = f"Q: {question}\nA: {answer}\nThis is because"
    else:
        user_message = (
            f"Question: {question}\n\n"
            f"Answer: {answer}\n\n"
            f"Provide an explanation for this answer:"
        )
    prompt = build_prompt(user_message)

    inputs = tokenizer(
        prompt, return_tensors="pt", truncation=True, max_length=1024
    ).to(model.device)

    with torch.no_grad():
        output = model.generate(
            **inputs, max_new_tokens=250, do_sample=False,
            pad_token_id=tokenizer.pad_token_id,
            eos_token_id=tokenizer.eos_token_id
        )

    generated_tokens = output[0][inputs.input_ids.shape[1]:]
    explanation = tokenizer.decode(generated_tokens, skip_special_tokens=True).strip()
    explanation = clean_generated_text(explanation)

    return explanation

# =====================================================
# LOAD DATASET
# =====================================================

print("\nLoading StrategyQA...")
dataset = load_dataset("wics/strategy-qa")
split_name = "test" if "test" in dataset else list(dataset.keys())[0]
questions = list(dataset[split_name])[:PILOT_SIZE]
print(f"Loaded {len(questions)} questions from split '{split_name}'.")
print(f"Sample item keys: {list(questions[0].keys())}")

# =====================================================
# MAIN LOOP
# =====================================================

rows = []

for idx, item in enumerate(tqdm(questions)):

    question = item["question"]
    true_answer = item["answer"]  # boolean

    print(f"\n[{idx:03d}/{len(questions)}] {question[:70]}...")

    try:
        (
            greedy_answer, sampled_answers, ebse, norm_ebse,
            n_clusters, cluster_answers
        ) = compute_ebse(question)

        explanation = get_explanation(question, greedy_answer)

        predicted_bool = extract_yes_no(greedy_answer)
        correct = is_correct_strategyqa(predicted_bool, true_answer)

        print(
            f"  ebse={norm_ebse:.3f} | clusters={n_clusters} | "
            f"pred={predicted_bool} | true={true_answer} | correct={correct}"
        )

        rows.append({
            "model": MODEL_SHORT,
            "dataset": "strategyqa",
            "question": question,
            "true_answer_bool": true_answer,
            "greedy_answer": greedy_answer,
            "predicted_bool": predicted_bool,
            "sampled_answers": " ||| ".join(sampled_answers),
            "cluster_answers": " ||| ".join(cluster_answers),
            "explanation": explanation,
            "correct": correct,
            "ebse": ebse,
            "norm_ebse": norm_ebse,
            "n_clusters": n_clusters,
        })

    except Exception as e:
        print(f"  ERROR: {e}")
        rows.append({
            "model": MODEL_SHORT, "dataset": "strategyqa",
            "question": question, "true_answer_bool": true_answer,
            "greedy_answer": None, "predicted_bool": None,
            "sampled_answers": None, "cluster_answers": None,
            "explanation": None, "correct": None,
            "ebse": None, "norm_ebse": None, "n_clusters": None,
        })

    if idx % 10 == 0:
        pd.DataFrame(rows).to_csv(OUTPUT_CSV, index=False)

df = pd.DataFrame(rows)
df.to_csv(OUTPUT_CSV, index=False)

valid = df[df["norm_ebse"].notna()]
extractable = valid[valid["correct"].notna()]
correct_df = extractable[extractable["correct"] == 1]
incorrect_df = extractable[extractable["correct"] == 0]

print(f"\n{'='*60}")
print(f"STRATEGYQA GENERATION SUMMARY: {MODEL_SHORT}")
print(f"{'='*60}")
print(f"Total: {len(df)} | Valid: {len(valid)} | Extractable: {len(extractable)}")
print(f"Correct: {len(correct_df)} | Incorrect: {len(incorrect_df)}")
if len(correct_df) > 0 and len(incorrect_df) > 0:
    print(f"EBSE correct:   {correct_df['norm_ebse'].mean():.4f}")
    print(f"EBSE incorrect: {incorrect_df['norm_ebse'].mean():.4f}")
print(f"\nSaved to: {OUTPUT_CSV}")


import os
import re
import torch
import numpy as np
import pandas as pd
from tqdm import tqdm
from collections import Counter
from datasets import load_dataset
from transformers import AutoTokenizer, AutoModelForCausalLM
from huggingface_hub import login

# =====================================================
# CONFIG
# =====================================================

HF_TOKEN = ''
MODEL_NAME = "meta-llama/Llama-3.1-8B-Instruct"

MODEL_SHORT = MODEL_NAME.split("/")[-1]
IS_BASE_MODEL = "Instruct" not in MODEL_NAME

BASE_DIR = "/workspace/data/KZ_2117574/Calibration/medqa"
OUTPUT_DIR = os.path.join(BASE_DIR, f"results_{MODEL_SHORT}")
os.makedirs(OUTPUT_DIR, exist_ok=True)
OUTPUT_CSV = os.path.join(OUTPUT_DIR, "generations.csv")

N_SAMPLES = 10
TEMPERATURE = 0.7
PILOT_SIZE = 200

print(f"Model: {MODEL_NAME} | Is base: {IS_BASE_MODEL}")

# =====================================================
# LOGIN + MODEL
# =====================================================

login(token=HF_TOKEN)

print("Loading tokenizer...")
tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME, trust_remote_code=True)
if tokenizer.pad_token is None:
    tokenizer.pad_token = tokenizer.eos_token

print("Loading model...")
model = AutoModelForCausalLM.from_pretrained(
    MODEL_NAME, torch_dtype=torch.float16,
    device_map="auto", trust_remote_code=True
)
model.eval()
print("Model loaded.")
print(f"EOS token: {tokenizer.eos_token} (id={tokenizer.eos_token_id})")
print(f"Chat template present: {tokenizer.chat_template is not None}")

# =====================================================
# CHAT TEMPLATE HELPER
# =====================================================

def build_prompt(user_message):
    if tokenizer.chat_template is not None and not IS_BASE_MODEL:
        messages = [{"role": "user", "content": user_message}]
        prompt = tokenizer.apply_chat_template(
            messages, tokenize=False, add_generation_prompt=True
        )
    else:
        prompt = user_message
    return prompt

def clean_generated_text(text):
    for marker in ["\nQ:", "\nQuestion:"]:
        if marker in text:
            text = text.split(marker)[0].strip()
    return text

# =====================================================
# MEDQA-SPECIFIC: formatting and extraction
# =====================================================

def format_medqa_question(item):
    """
    bigbio/med_qa_en_source format:
    item['question'], item['options'] is a list of {"key": "A", "value": "..."}
    item['answer_idx'] is the correct key (e.g. "A")
    """
    options_text = "\n".join(
        f"{opt['key']}. {opt['value']}" for opt in item["options"]
    )
    return f"{item['question']}\n\n{options_text}"

def extract_option_letter(text):
    """Extract first standalone A-E letter from generated text."""
    match = re.search(r'\b([A-E])\b', text[:80])
    if match:
        return match.group(1)
    return None

def get_option_text(item, letter):
    for opt in item["options"]:
        if opt["key"] == letter:
            return opt["value"]
    return None

def is_correct_medqa(predicted_letter, correct_letter):
    if predicted_letter is None:
        return None
    return int(predicted_letter == correct_letter)

# =====================================================
# FUNCTION 1: EBSE via discrete option-letter entropy
# No embedding clustering needed — answer space is
# already discrete (5 options).
# =====================================================

def compute_ebse_medqa(item):

    question_formatted = format_medqa_question(item)

    if IS_BASE_MODEL:
        user_message = f"Q: {question_formatted}\nA:"
    else:
        user_message = (
            f"Answer the following medical question by selecting "
            f"the single best option (A, B, C, D, or E).\n\n"
            f"{question_formatted}\n\nAnswer:"
        )
    prompt = build_prompt(user_message)

    inputs = tokenizer(
        prompt, return_tensors="pt", truncation=True, max_length=1536
    ).to(model.device)

    with torch.no_grad():
        outputs = model.generate(
            **inputs, max_new_tokens=30, do_sample=True,
            temperature=TEMPERATURE, num_return_sequences=N_SAMPLES,
            pad_token_id=tokenizer.pad_token_id,
            eos_token_id=tokenizer.eos_token_id
        )

    sampled_letters = []
    sampled_texts = []
    for seq in outputs:
        generated = seq[inputs.input_ids.shape[1]:]
        text = tokenizer.decode(generated, skip_special_tokens=True).strip()
        text = clean_generated_text(text)
        letter = extract_option_letter(text)
        sampled_texts.append(text[:100])
        if letter:
            sampled_letters.append(letter)

    with torch.no_grad():
        greedy_out = model.generate(
            **inputs, max_new_tokens=30, do_sample=False,
            pad_token_id=tokenizer.pad_token_id,
            eos_token_id=tokenizer.eos_token_id
        )
    greedy_tokens = greedy_out[0][inputs.input_ids.shape[1]:]
    greedy_text = tokenizer.decode(greedy_tokens, skip_special_tokens=True).strip()
    greedy_text = clean_generated_text(greedy_text)
    greedy_letter = extract_option_letter(greedy_text)

    # Entropy directly over observed option letters
    if len(sampled_letters) == 0:
        return greedy_text, greedy_letter, sampled_texts, 0.0, 0.0, 0

    counts = Counter(sampled_letters)
    total = sum(counts.values())
    probs = np.array([c / total for c in counts.values()])

    epsilon = 1e-10
    entropy = -np.sum(probs * np.log(probs + epsilon))
    max_entropy = np.log(5)  # 5 possible options
    norm_ebse = entropy / max_entropy if max_entropy > 0 else 0.0
    n_distinct = len(counts)

    return greedy_text, greedy_letter, sampled_texts, entropy, norm_ebse, n_distinct

# =====================================================
# FUNCTION 2: Explanation
# =====================================================

def get_explanation_medqa(item, answer_letter, answer_text):

    question_formatted = format_medqa_question(item)

    if IS_BASE_MODEL:
        user_message = (
            f"Q: {question_formatted}\n"
            f"A: {answer_letter}. {answer_text}\n"
            f"This is because"
        )
    else:
        user_message = (
            f"Question: {question_formatted}\n\n"
            f"Answer: {answer_letter}. {answer_text}\n\n"
            f"Provide an explanation for this answer:"
        )
    prompt = build_prompt(user_message)

    inputs = tokenizer(
        prompt, return_tensors="pt", truncation=True, max_length=1536
    ).to(model.device)

    with torch.no_grad():
        output = model.generate(
            **inputs, max_new_tokens=250, do_sample=False,
            pad_token_id=tokenizer.pad_token_id,
            eos_token_id=tokenizer.eos_token_id
        )

    generated_tokens = output[0][inputs.input_ids.shape[1]:]
    explanation = tokenizer.decode(generated_tokens, skip_special_tokens=True).strip()
    explanation = clean_generated_text(explanation)

    return explanation

# =====================================================
# LOAD DATASET
# =====================================================

print("\nLoading MedQA...")
dataset = load_dataset("bigbio/med_qa", "med_qa_en_source")
split_name = "test" if "test" in dataset else list(dataset.keys())[0]
questions = list(dataset[split_name])[:PILOT_SIZE]
print(f"Loaded {len(questions)} questions from split '{split_name}'.")
print(f"Sample item keys: {list(questions[0].keys())}")

# =====================================================
# MAIN LOOP
# =====================================================

rows = []

for idx, item in enumerate(tqdm(questions)):

    question = item["question"]
    correct_letter = item["answer_idx"]
    correct_text = get_option_text(item, correct_letter)

    print(f"\n[{idx:03d}/{len(questions)}] {question[:70]}...")

    try:
        (
            greedy_text, greedy_letter, sampled_texts,
            ebse, norm_ebse, n_distinct
        ) = compute_ebse_medqa(item)

        answer_text_for_explanation = (
            get_option_text(item, greedy_letter)
            if greedy_letter else greedy_text
        )

        explanation = get_explanation_medqa(
            item, greedy_letter or "?", answer_text_for_explanation
        )

        correct = is_correct_medqa(greedy_letter, correct_letter)

        print(
            f"  ebse={norm_ebse:.3f} | distinct_options={n_distinct} | "
            f"pred={greedy_letter} | true={correct_letter} | correct={correct}"
        )

        rows.append({
            "model": MODEL_SHORT,
            "dataset": "medqa",
            "question": question,
            "options": str(item["options"]),
            "correct_letter": correct_letter,
            "correct_text": correct_text,
            "greedy_raw": greedy_text,
            "predicted_letter": greedy_letter,
            "greedy_answer": answer_text_for_explanation,
            "sampled_texts": " ||| ".join(sampled_texts),
            "explanation": explanation,
            "correct": correct,
            "ebse": ebse,
            "norm_ebse": norm_ebse,
            "n_distinct_options": n_distinct,
        })

    except Exception as e:
        print(f"  ERROR: {e}")
        rows.append({
            "model": MODEL_SHORT, "dataset": "medqa",
            "question": question, "options": str(item["options"]),
            "correct_letter": correct_letter, "correct_text": correct_text,
            "greedy_raw": None, "predicted_letter": None,
            "greedy_answer": None, "sampled_texts": None,
            "explanation": None, "correct": None,
            "ebse": None, "norm_ebse": None, "n_distinct_options": None,
        })

    if idx % 10 == 0:
        pd.DataFrame(rows).to_csv(OUTPUT_CSV, index=False)

df = pd.DataFrame(rows)
df.to_csv(OUTPUT_CSV, index=False)

valid = df[df["norm_ebse"].notna()]
extractable = valid[valid["correct"].notna()]
correct_df = extractable[extractable["correct"] == 1]
incorrect_df = extractable[extractable["correct"] == 0]

print(f"\n{'='*60}")
print(f"MEDQA GENERATION SUMMARY: {MODEL_SHORT}")
print(f"{'='*60}")
print(f"Total: {len(df)} | Valid: {len(valid)} | Extractable: {len(extractable)}")
print(f"Correct: {len(correct_df)} | Incorrect: {len(incorrect_df)}")
if len(correct_df) > 0 and len(incorrect_df) > 0:
    print(f"EBSE correct:   {correct_df['norm_ebse'].mean():.4f}")
    print(f"EBSE incorrect: {incorrect_df['norm_ebse'].mean():.4f}")
print(f"\nSaved to: {OUTPUT_CSV}")


