def experiment_B(
    records,
    output_dir,
    n_boot,
    seed,
):
    """
    Correct vs incorrect support scores.
    """

    print("=" * 70)
    print("EXPERIMENT B: JUSTIFICATION BIAS")
    print("=" * 70)

    results = []

    for rec in records:

        if "support" not in rec["types"]:
            continue

        df = rec["df"].copy()

        correctness_col = get_correctness_column(df)

        if correctness_col is None:
            print(
                f"[B SKIP] {rec['path'].name}: "
                "no correctness column"
            )
            continue

        df["_correct"] = normalize_correctness(
            df[correctness_col]
        )

        df["_support"] = safe_numeric(
            df["support_score"]
        )

        groups = df.groupby(["dataset", "model"], dropna=False)

        for (dataset, model), g in groups:

            dataset = normalize_dataset_name(dataset)
            model = normalize_model_name(model)

            temp = g[["_correct", "_support"]].dropna()

            correct_scores = (
                temp.loc[temp["_correct"] == 1, "_support"]
                .to_numpy()
            )

            incorrect_scores = (
                temp.loc[temp["_correct"] == 0, "_support"]
                .to_numpy()
            )

            if len(correct_scores) == 0 or len(incorrect_scores) == 0:
                continue

            mw = mannwhitneyu(
                correct_scores,
                incorrect_scores,
                alternative="two-sided",
            )

            effect = rank_biserial(
                correct_scores,
                incorrect_scores,
            )

            ci_low, ci_high, valid_boot = (
                bootstrap_rank_biserial_ci(
                    correct_scores,
                    incorrect_scores,
                    n_boot=n_boot,
                    seed=seed,
                )
            )

            mean_correct = np.mean(correct_scores)
            mean_incorrect = np.mean(incorrect_scores)

            # Define gap clearly:
            # positive = greater support for correct answers.
            support_gap = mean_correct - mean_incorrect

            # Spearman correctness <-> support as secondary analysis.
            rho, rho_p = safe_spearman(
                temp["_correct"],
                temp["_support"],
            )

            results.append({
                "dataset": dataset,
                "model": model,
                "condition": rec["condition"],
                "file": rec["path"].name,
                "correctness_column": correctness_col,
                "n_total": len(temp),
                "n_correct": len(correct_scores),
                "n_incorrect": len(incorrect_scores),
                "support_correct_mean": mean_correct,
                "support_incorrect_mean": mean_incorrect,
                "support_gap_correct_minus_incorrect": support_gap,
                "mannwhitney_U": mw.statistic,
                "mannwhitney_p": mw.pvalue,
                "rank_biserial": effect,
                "rank_biserial_ci95_low": ci_low,
                "rank_biserial_ci95_high": ci_high,
                "spearman_correctness_support": rho,
                "spearman_p": rho_p,
                "bootstrap_valid": valid_boot,
            })

            print(
                f"{dataset:12} | "
                f"{model:28} | "
                f"{rec['condition']:7}\n"
                f"  correct={mean_correct:.2f} "
                f"(n={len(correct_scores)}) | "
                f"incorrect={mean_incorrect:.2f} "
                f"(n={len(incorrect_scores)})\n"
                f"  gap(C-I)={support_gap:.2f} | "
                f"MW p={mw.pvalue:.4g} | "
                f"RBC={effect:.4f} "
                f"[{ci_low:.4f}, {ci_high:.4f}]"
            )

    result_df = pd.DataFrame(results)

    path = output_dir / "experiment_B_justification.csv"
    result_df.to_csv(path, index=False)

    print()
    print(f"Saved: {path}")
    print()

    return result_df


