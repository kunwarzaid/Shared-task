def extract_option_letter_by_content_match(generated_text, item):
    """
    Fallback for base models: if no letter is found, check
    whether the generated text's content matches one of the
    option values directly (the model stated the answer's
    substance rather than its label).
    """
    text_lower = generated_text[:150].lower().strip()
    
    best_match = None
    best_overlap = 0
    
    for opt in item["options"]:
        opt_text_lower = opt["value"].lower().strip()
        opt_words = set(opt_text_lower.split())
        text_words = set(text_lower.split())
        
        if len(opt_words) == 0:
            continue
        
        overlap = len(opt_words & text_words) / len(opt_words)
        
        # Also check if option text appears as a substring
        # (handles short answers like "0.375" or "Duodenal atresia")
        substring_match = opt_text_lower in text_lower
        
        if substring_match or overlap > 0.6:
            if overlap > best_overlap or substring_match:
                best_match = opt["key"]
                best_overlap = overlap
    
    return best_match
