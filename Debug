"""
Recompute Experiment C (mechanism ablation) with MATCHED closed-form
Uhat estimators on both post-hoc and joint MedQA, replacing the old
sampling-based comparison that Table/Figure 3 currently reports.

For MedQA: uses the closed-form judged CSVs for post-hoc and joint,
matches them on question text, computes a paired bootstrap over
questions to get Delta-rho = rho_Joint - rho_Post-hoc with a 95% CI,
per model.

For StrategyQA: unchanged -- still uses the existing sampling-based
EBSE post-hoc/joint pairs, since no closed-form estimator applies
there (see Limitations).

Combines both into the aggregate 12-pair test (Wilcoxon signed-rank),
matching the format already reported in the paper.

Run this once. It automatically finds and matches all six MedQA
post-hoc/joint file pairs.
"""

import os
import glob
import numpy as np
import pandas as pd
from scipy.stats import spearmanr, wilcoxon

# =====================================================
# CONFIG -- adjust paths if your folder structure differs
# =====================================================

# Closed-form MedQA post-hoc judged CSVs (one per model)
MEDQA_POSTHOC_DIR = "MedQA/closed_form/gpt_judge"
MEDQA_POSTHOC_PATTERN = "generations_closed_form_*_v2_gpt_judge.csv"

# Closed-form MedQA joint judged CSVs (one per model)
MEDQA_JOINT_DIR = "MedQA/closed_form_joint/gpt_judge"
MEDQA_JOINT_PATTERN = "generations_closed_form_joint_*_gpt_judge.csv"

# StrategyQA post-hoc/joint judged CSVs -- unchanged, still
# sampling-based. Point these at your existing files.
STRATEGYQA_POSTHOC_DIR = "StrategyQA/gpt_judge"
STRATEGYQA_POSTHOC_PATTERN = "*posthoc*gpt_judge.csv"
STRATEGYQA_JOINT_DIR = "StrategyQA/gpt_judge"
STRATEGYQA_JOINT_PATTERN = "*joint*gpt_judge.csv"

N_BOOTSTRAP = 1000
RNG_SEED = 42

OUTPUT_CSV = "experiment_c_recomputed.csv"

# =====================================================
# HELPERS
# =====================================================

MODEL_KEYS = ["llama_base", "llama_instruct", "qwen_base", "qwen_instruct",
              "mistral_base", "mistral_instruct"]


def extract_model_key(filename):
    fname = filename.lower()
    for m in MODEL_KEYS:
        if m in fname:
            return m
        alt = m.replace("_", "")
        if alt in fname.replace("_", "").replace("-", ""):
            return m
    return None


def find_uncertainty_col(df):
    for c in ["norm_uhat", "norm_ebse"]:
        if c in df.columns:
            return c
    return None


def find_judge_col(df):
    for c in ["gpt_perceived_uncertainty", "gpt_uncertainty"]:
        if c in df.columns:
            return c
    return None


def paired_bootstrap_delta_rho(uhat_a, judge_a, uhat_b, judge_b, n_boot=N_BOOTSTRAP, seed=RNG_SEED):
    """
    Computes rho_b - rho_a (e.g., Joint minus Post-hoc) with a
    bootstrap CI, resampling QUESTION INDICES jointly for both
    conditions (since the same questions appear in both, this
    preserves the pairing structure).
    """
    n = len(uhat_a)
    assert len(uhat_b) == n, "Post-hoc and joint arrays must be the same length (matched questions)"

    rho_a, _ = spearmanr(uhat_a, judge_a)
    rho_b, _ = spearmanr(uhat_b, judge_b)
    point_delta = rho_b - rho_a

    rng = np.random.default_rng(seed)
    boot_deltas = np.empty(n_boot)
    uhat_a, judge_a, uhat_b, judge_b = map(np.asarray, (uhat_a, judge_a, uhat_b, judge_b))

    for i in range(n_boot):
        idx = rng.integers(0, n, size=n)
        r_a, _ = spearmanr(uhat_a[idx], judge_a[idx])
        r_b, _ = spearmanr(uhat_b[idx], judge_b[idx])
        boot_deltas[i] = r_b - r_a

    ci_lo, ci_hi = np.percentile(boot_deltas, [2.5, 97.5])
    return rho_a, rho_b, point_delta, ci_lo, ci_hi


def load_and_match(posthoc_path, joint_path):
    """Loads both CSVs, matches on question text, returns aligned arrays."""
    post_df = pd.read_csv(posthoc_path)
    joint_df = pd.read_csv(joint_path)

    post_uhat_col = find_uncertainty_col(post_df)
    post_judge_col = find_judge_col(post_df)
    joint_uhat_col = find_uncertainty_col(joint_df)
    joint_judge_col = find_judge_col(joint_df)

    missing = []
    if post_uhat_col is None or post_judge_col is None:
        missing.append(f"post-hoc file missing uncertainty/judge column: {post_df.columns.tolist()}")
    if joint_uhat_col is None or joint_judge_col is None:
        missing.append(f"joint file missing uncertainty/judge column: {joint_df.columns.tolist()}")
    if missing:
        print("  " + "\n  ".join(missing))
        return None

    post_df["_q"] = post_df["question"].astype(str).str.strip()
    joint_df["_q"] = joint_df["question"].astype(str).str.strip()

    merged = pd.merge(
        post_df[["_q", post_uhat_col, post_judge_col]].rename(
            columns={post_uhat_col: "uhat_post", post_judge_col: "judge_post"}
        ),
        joint_df[["_q", joint_uhat_col, joint_judge_col]].rename(
            columns={joint_uhat_col: "uhat_joint", joint_judge_col: "judge_joint"}
        ),
        on="_q", how="inner"
    )
    merged = merged.dropna(subset=["uhat_post", "judge_post", "uhat_joint", "judge_joint"])

    print(f"  Matched {len(merged)} questions "
          f"(post-hoc had {len(post_df)}, joint had {len(joint_df)})")

    return merged


# =====================================================
# MEDQA: RECOMPUTE WITH MATCHED CLOSED-FORM ESTIMATOR
# =====================================================

print("="*70)
print("MEDQA -- closed-form, matched post-hoc vs joint")
print("="*70)

posthoc_files = glob.glob(os.path.join(MEDQA_POSTHOC_DIR, MEDQA_POSTHOC_PATTERN))
joint_files = glob.glob(os.path.join(MEDQA_JOINT_DIR, MEDQA_JOINT_PATTERN))

posthoc_by_model = {extract_model_key(os.path.basename(f)): f for f in posthoc_files}
joint_by_model = {extract_model_key(os.path.basename(f)): f for f in joint_files}

print(f"Found {len(posthoc_by_model)} post-hoc files, {len(joint_by_model)} joint files.")

results = []

for model in MODEL_KEYS:
    print(f"\n--- {model} ---")
    if model not in posthoc_by_model:
        print(f"  SKIP: no closed-form post-hoc file found")
        continue
    if model not in joint_by_model:
        print(f"  SKIP: no closed-form joint file found")
        continue

    merged = load_and_match(posthoc_by_model[model], joint_by_model[model])
    if merged is None or len(merged) < 10:
        print(f"  SKIP: insufficient matched data")
        continue

    rho_post, rho_joint, delta, ci_lo, ci_hi = paired_bootstrap_delta_rho(
        merged["uhat_post"], merged["judge_post"],
        merged["uhat_joint"], merged["judge_joint"],
    )

    print(f"  rho_post-hoc = {rho_post:.4f}")
    print(f"  rho_joint    = {rho_joint:.4f}")
    print(f"  Delta_rho    = {delta:.4f}   95% CI = [{ci_lo:.4f}, {ci_hi:.4f}]")
    sig = "SIGNIFICANT" if (ci_lo > 0 or ci_hi < 0) else "n.s."
    print(f"  -> {sig}")

    results.append({
        "dataset": "MedQA", "model": model, "estimator": "closed-form",
        "n": len(merged), "rho_posthoc": rho_post, "rho_joint": rho_joint,
        "delta_rho": delta, "ci_lo": ci_lo, "ci_hi": ci_hi,
    })

# =====================================================
# STRATEGYQA: UNCHANGED, SAMPLING-BASED
# =====================================================

print(f"\n{'='*70}")
print("STRATEGYQA -- sampling-based (unchanged)")
print(f"{'='*70}")

sq_posthoc_files = glob.glob(os.path.join(STRATEGYQA_POSTHOC_DIR, STRATEGYQA_POSTHOC_PATTERN))
sq_joint_files = glob.glob(os.path.join(STRATEGYQA_JOINT_DIR, STRATEGYQA_JOINT_PATTERN))

sq_posthoc_by_model = {extract_model_key(os.path.basename(f)): f for f in sq_posthoc_files}
sq_joint_by_model = {extract_model_key(os.path.basename(f)): f for f in sq_joint_files}

print(f"Found {len(sq_posthoc_by_model)} StrategyQA post-hoc files, "
      f"{len(sq_joint_by_model)} joint files.")

for model in MODEL_KEYS:
    print(f"\n--- {model} ---")
    if model not in sq_posthoc_by_model or model not in sq_joint_by_model:
        print(f"  SKIP: missing StrategyQA post-hoc or joint file for this model")
        print(f"  (if you already have these Delta-rho values from the existing")
        print(f"  paper, no need to recompute -- just keep those numbers)")
        continue

    merged = load_and_match(sq_posthoc_by_model[model], sq_joint_by_model[model])
    if merged is None or len(merged) < 10:
        continue

    rho_post, rho_joint, delta, ci_lo, ci_hi = paired_bootstrap_delta_rho(
        merged["uhat_post"], merged["judge_post"],
        merged["uhat_joint"], merged["judge_joint"],
    )

    print(f"  rho_post-hoc = {rho_post:.4f}")
    print(f"  rho_joint    = {rho_joint:.4f}")
    print(f"  Delta_rho    = {delta:.4f}   95% CI = [{ci_lo:.4f}, {ci_hi:.4f}]")

    results.append({
        "dataset": "StrategyQA", "model": model, "estimator": "sampling-based",
        "n": len(merged), "rho_posthoc": rho_post, "rho_joint": rho_joint,
        "delta_rho": delta, "ci_lo": ci_lo, "ci_hi": ci_hi,
    })

# =====================================================
# AGGREGATE ACROSS ALL AVAILABLE PAIRS
# =====================================================

if results:
    results_df = pd.DataFrame(results)
    results_df.to_csv(OUTPUT_CSV, index=False)

    print(f"\n{'='*70}")
    print("FULL RESULTS")
    print(f"{'='*70}")
    print(results_df.to_string(index=False))

    n_favor_joint = (results_df["delta_rho"] > 0).sum()
    n_favor_posthoc = (results_df["delta_rho"] < 0).sum()
    n_significant = ((results_df["ci_lo"] > 0) | (results_df["ci_hi"] < 0)).sum()

    print(f"\n{'='*70}")
    print("AGGREGATE SUMMARY")
    print(f"{'='*70}")
    print(f"Total pairs: {len(results_df)}")
    print(f"Favor Joint: {n_favor_joint} | Favor Post-hoc: {n_favor_posthoc}")
    print(f"Individually significant: {n_significant}")
    print(f"Mean Delta_rho: {results_df['delta_rho'].mean():.4f}")
    print(f"Median Delta_rho: {results_df['delta_rho'].median():.4f}")

    if len(results_df) >= 2:
        stat, p = wilcoxon(results_df["rho_joint"], results_df["rho_posthoc"])
        print(f"Wilcoxon signed-rank (rho_joint vs rho_posthoc): "
              f"statistic={stat:.2f}, p={p:.4f}")

    print(f"\nSaved full results to: {OUTPUT_CSV}")
else:
    print("\nNo results produced. Check that MEDQA_POSTHOC_DIR, MEDQA_JOINT_DIR,")
    print("and the StrategyQA paths above match your actual file locations.")
    print("Run `ls <dir>` on each and adjust the CONFIG section if needed.")
