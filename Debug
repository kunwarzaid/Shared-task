"""
Compare Truth Sensitivity Gap under the hedging-licensed elicitation
condition against the original post-hoc condition, for the same
model, dataset, and questions.

Run this AFTER:
1. hedging_licensed_generation.py has produced explanations under
   the new prompt.
2. The existing support-score judge script has been run on that
   output (same judge prompt as always -- just point INPUT_CSV at
   the hedging-licensed generations file).

This produces the key comparison for the paper: does support for
incorrect answers drop when hedging is explicitly licensed, or does
it persist at the same level as the original post-hoc condition?
"""

import pandas as pd
import numpy as np
from scipy.stats import mannwhitneyu

# =====================================================
# CONFIG
# =====================================================

HEDGING_SCORED_CSV = "medqa_llama_instruct_hedging_licensed_scored.csv"
ORIGINAL_POSTHOC_SCORED_CSV = "medqa_llama_instruct_support_scored.csv"

CORRECTNESS_COL = "correct"  # adjust to correct_v2 for MedQA if needed

# =====================================================
# LOAD BOTH
# =====================================================

hedging = pd.read_csv(HEDGING_SCORED_CSV)
original = pd.read_csv(ORIGINAL_POSTHOC_SCORED_CSV)

def tsg_summary(df, label):
    valid = df[df["support_score"].notna() & df[CORRECTNESS_COL].notna()].copy()
    valid[CORRECTNESS_COL] = valid[CORRECTNESS_COL].astype(int)

    correct_support = valid[valid[CORRECTNESS_COL] == 1]["support_score"]
    incorrect_support = valid[valid[CORRECTNESS_COL] == 0]["support_score"]

    if len(correct_support) < 2 or len(incorrect_support) < 2:
        print(f"{label}: insufficient data")
        return None

    u, p = mannwhitneyu(correct_support, incorrect_support)
    tsg = correct_support.mean() - incorrect_support.mean()

    print(f"\n{label}")
    print(f"  Support (correct):   mean={correct_support.mean():.1f}  n={len(correct_support)}")
    print(f"  Support (incorrect): mean={incorrect_support.mean():.1f}  n={len(incorrect_support)}")
    print(f"  TSG = {tsg:.2f}")
    print(f"  Mann-Whitney p = {p:.4f}")

    return {
        "label": label,
        "support_correct": correct_support.mean(),
        "support_incorrect": incorrect_support.mean(),
        "n_correct": len(correct_support),
        "n_incorrect": len(incorrect_support),
        "tsg": tsg,
        "p": p,
    }

print("=== Truth Sensitivity Gap: Hedging-Licensed vs Original Post-Hoc ===")
hedging_result = tsg_summary(hedging, "Hedging-licensed elicitation")
original_result = tsg_summary(original, "Original post-hoc (justificatory prompt)")

if hedging_result and original_result:
    print(f"\n{'='*60}")
    print("COMPARISON")
    print(f"{'='*60}")
    delta_incorrect_support = (
        hedging_result["support_incorrect"] - original_result["support_incorrect"]
    )
    print(f"Change in incorrect-answer support: {delta_incorrect_support:+.1f}")
    if abs(delta_incorrect_support) < 10:
        print(">> Support for incorrect answers remains high even when hedging")
        print("   is explicitly licensed -- F3 is not simply an artifact of the")
        print("   original justificatory prompt framing.")
    else:
        print(">> Support for incorrect answers drops substantially under the")
        print("   hedging-licensed prompt -- the original prompt's justificatory")
        print("   framing was doing real work. This is a positive mitigation")
        print("   finding: a simple prompt change measurably reduces unwarranted")
        print("   justification.")
