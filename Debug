
import os
import json
import time
import pandas as pd
from openai import AzureOpenAI

# =====================================================
# CONFIG
# =====================================================

AZURE_ENDPOINT = "https://ctonpncuaaiopenai.openai.azure.com/"
AZURE_API_KEY = 
AZURE_API_VERSION = "2024-12-01-preview"
DEPLOYMENT_NAME = "gpt-5"


# Point this at any CSV that has: question, greedy_answer, references
INPUT_CSV = "generations_mistral_base.csv"
OUTPUT_CSV = "mistral_base_correctness_recheck.csv"

MAX_RETRIES = 3
RETRY_DELAY = 5

client = AzureOpenAI(
    azure_endpoint=AZURE_ENDPOINT,
    api_key=AZURE_API_KEY,
    api_version=AZURE_API_VERSION
)

print("Azure client initialized.")

# =====================================================
# CORRECTNESS JUDGE
# =====================================================

CORRECTNESS_SYSTEM_PROMPT = """You are fact-checking an
answer against reference correct answers for a question.

Determine if the given answer is factually correct and
consistent with the meaning of at least one reference
answer. Allow for paraphrasing, different wording, added
detail, or partial matches.

Do NOT mark it correct if the answer:
- Negates or contradicts the reference meaning
- States the opposite conclusion
- Is factually different even if it shares many words

Do NOT mark it incorrect just because the wording differs
from the reference, as long as the core factual claim
matches.

Return ONLY valid JSON:
{
  "is_correct": true or false,
  "reason": "<one sentence explaining your judgment>"
}"""

CORRECTNESS_USER_TEMPLATE = """Question: {question}

Answer given: {answer}

Reference correct answers (any one matching is sufficient):
{references}

Is the given answer factually correct according to the
references above?

Respond with a JSON object in exactly this format:
{{
  "is_correct": true or false,
  "reason": "<one sentence explaining your judgment>"
}}

Return only the JSON object. No other text."""

def judge_correctness(question, answer, references):

    user_message = CORRECTNESS_USER_TEMPLATE.format(
        question=question,
        answer=answer,
        references=references
    )

    for attempt in range(MAX_RETRIES):
        try:
            response = client.chat.completions.create(
                model=DEPLOYMENT_NAME,
                messages=[
                    {
                        "role": "system",
                        "content": CORRECTNESS_SYSTEM_PROMPT
                    },
                    {
                        "role": "user",
                        "content": user_message
                    }
                ],
                # temperature=0.0,
                # max_completion_tokens=150
            )

            raw = response.choices[0].message.content.strip()
            clean = raw.replace(
                "```json", ""
            ).replace("```", "").strip()
            parsed = json.loads(clean)

            is_correct = bool(parsed["is_correct"])
            reason = parsed.get("reason", "")

            return is_correct, reason

        except json.JSONDecodeError as e:
            print(f"  JSON error attempt {attempt+1}: {e}")
            if attempt < MAX_RETRIES - 1:
                time.sleep(RETRY_DELAY)
            else:
                return None, "JSON parse failed"

        except Exception as e:
            print(f"  API error attempt {attempt+1}: {e}")
            if attempt < MAX_RETRIES - 1:
                time.sleep(RETRY_DELAY)
            else:
                return None, str(e)

    return None, "Max retries exceeded"

# =====================================================
# LOAD DATA
# =====================================================

df = pd.read_csv(INPUT_CSV)
print(f"Loaded {len(df)} rows from {INPUT_CSV}")

required_cols = ["question", "greedy_answer", "references"]
missing = [c for c in required_cols if c not in df.columns]
if missing:
    raise ValueError(f"Missing columns: {missing}")

# Keep old correctness label for comparison
if "correct" in df.columns:
    df["correct_old_heuristic"] = df["correct"]

for col in ["correct_gpt", "correct_gpt_reason"]:
    if col not in df.columns:
        df[col] = None

# =====================================================
# MAIN LOOP
# =====================================================

n_success = 0
n_failed = 0

for idx, row in df.iterrows():

    if pd.notna(df.at[idx, "correct_gpt"]):
        continue

    question = str(row["question"])
    answer = str(row["greedy_answer"])
    references = str(row["references"])

    if pd.isna(row["greedy_answer"]) or answer in ("None", "nan"):
        n_failed += 1
        continue

    is_correct, reason = judge_correctness(
        question, answer, references
    )

    if is_correct is not None:
        df.at[idx, "correct_gpt"] = int(is_correct)
        df.at[idx, "correct_gpt_reason"] = reason
        n_success += 1

        old_label = row.get("correct_old_heuristic", "N/A")
        match = "MATCH" if int(is_correct) == old_label else "DIFFER"

        print(
            f"[{idx:03d}] gpt={int(is_correct)} | "
            f"old={old_label} | {match} | {reason[:50]}..."
        )
    else:
        n_failed += 1
        print(f"[{idx:03d}] FAILED — {reason}")

    if idx % 10 == 0:
        df.to_csv(OUTPUT_CSV, index=False)

df.to_csv(OUTPUT_CSV, index=False)
print(f"\nScoring complete. Saved to: {OUTPUT_CSV}")
print(f"Success: {n_success} | Failed: {n_failed}")

# =====================================================
# COMPARISON: OLD HEURISTIC vs GPT JUDGE
# =====================================================

scored = df[df["correct_gpt"].notna()].copy()
scored["correct_gpt"] = scored["correct_gpt"].astype(int)

if "correct_old_heuristic" in scored.columns:
    agreement = (
        scored["correct_gpt"] == scored["correct_old_heuristic"]
    ).mean()

    print(f"\n{'='*60}")
    print("CORRECTNESS LABEL COMPARISON")
    print(f"{'='*60}")
    print(f"Agreement between old heuristic and GPT judge: {agreement:.1%}")

    print(f"\nOld heuristic — Correct: {(scored['correct_old_heuristic']==1).sum()} | "
          f"Incorrect: {(scored['correct_old_heuristic']==0).sum()}")
    print(f"GPT judge     — Correct: {(scored['correct_gpt']==1).sum()} | "
          f"Incorrect: {(scored['correct_gpt']==0).sum()}")

    # Show disagreements for manual inspection
    disagreements = scored[
        scored["correct_gpt"] != scored["correct_old_heuristic"]
    ]
    print(f"\nDisagreements: {len(disagreements)} / {len(scored)}")

    if len(disagreements) > 0:
        print(f"\n{'='*60}")
        print("SAMPLE DISAGREEMENTS (first 10)")
        print(f"{'='*60}")
        for _, row in disagreements.head(10).iterrows():
            print(f"\nQ: {row['question']}")
            print(f"A: {row['greedy_answer']}")
            print(f"References: {row['references'][:150]}...")
            print(
                f"Old heuristic: {row['correct_old_heuristic']} | "
                f"GPT judge: {row['correct_gpt']}"
            )
            print(f"GPT reason: {row['correct_gpt_reason']}")

print(f"\nSaved to: {OUTPUT_CSV}")

