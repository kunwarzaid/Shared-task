import pandas as pd
import ast

df = pd.read_csv("medqa/results_Mistral-7B-v0.1/generations.csv")

def reparse_row(row):
    if pd.notna(row["predicted_letter"]):
        return row["predicted_letter"]  # already succeeded, keep it
    
    item = {"options": ast.literal_eval(row["options"])}
    return extract_option_letter_combined(row["greedy_raw"], item)

df["predicted_letter_v2"] = df.apply(reparse_row, axis=1)

print(f"Original extraction rate: {df['predicted_letter'].notna().mean():.1%}")
print(f"Improved extraction rate: {df['predicted_letter_v2'].notna().mean():.1%}")

df.to_csv("medqa/results_Mistral-7B-v0.1/generations_v2.csv", index=False)
