def collect_uncertainty_frames(records, ebse_column):
    """
    Convert all uncertainty files into a common schema.

    Output columns:
        dataset
        model
        condition
        question
        ebse
        gpt_uncertainty
        source_file
    """

    frames = []

    for rec in records:

        if "uncertainty" not in rec["types"]:
            continue

        df = rec["df"].copy()

        if ebse_column not in df.columns:
            continue

        needed = [
            "dataset",
            "model",
            "question",
            ebse_column,
            "gpt_perceived_uncertainty",
        ]

        if any(col not in df.columns for col in needed):
            continue

        temp = df[needed].copy()

        temp["dataset"] = (
            temp["dataset"]
            .apply(normalize_dataset_name)
        )

        temp["model"] = (
            temp["model"]
            .apply(normalize_model_name)
        )

        temp["condition"] = rec["condition"]

        temp["question"] = (
            temp["question"]
            .apply(normalize_question)
        )

        temp["ebse"] = safe_numeric(
            temp[ebse_column]
        )

        temp["gpt_uncertainty"] = safe_numeric(
            temp["gpt_perceived_uncertainty"]
        )

        temp["source_file"] = rec["path"].name

        frames.append(
            temp[
                [
                    "dataset",
                    "model",
                    "condition",
                    "question",
                    "ebse",
                    "gpt_uncertainty",
                    "source_file",
                ]
            ]
        )

    if not frames:
        return pd.DataFrame()

    return pd.concat(frames, ignore_index=True)


# ============================================================
# C1: QUESTION PAIRING VALIDATION
# ============================================================

def validate_question_pairing(joint, posthoc):
    """
    Mandatory validation that Joint and Post-hoc contain
    exactly the same questions.

    Returns:
        qc dict
        can_proceed bool
    """

    joint_questions = joint["question"].tolist()
    post_questions = posthoc["question"].tolist()

    joint_duplicates = (
        joint["question"].duplicated(keep=False).sum()
    )

    post_duplicates = (
        posthoc["question"].duplicated(keep=False).sum()
    )

    joint_set = set(joint_questions)
    post_set = set(post_questions)

    joint_only = joint_set - post_set
    post_only = post_set - joint_set

    shared = joint_set & post_set

    exact_match = (
        len(joint_only) == 0
        and len(post_only) == 0
        and joint_duplicates == 0
        and post_duplicates == 0
        and len(joint) == len(posthoc)
    )

    qc = {
        "joint_n": len(joint),
        "posthoc_n": len(posthoc),
        "shared_questions": len(shared),
        "joint_only_n": len(joint_only),
        "posthoc_only_n": len(post_only),
        "joint_duplicate_rows": joint_duplicates,
        "posthoc_duplicate_rows": post_duplicates,
        "exact_question_match": exact_match,
        "joint_only_examples": " ||| ".join(
            list(sorted(joint_only))[:5]
        ),
        "posthoc_only_examples": " ||| ".join(
            list(sorted(post_only))[:5]
        ),
    }

    return qc, exact_match


# ============================================================
# C1: PAIRED BOOTSTRAP DELTA RHO
# ============================================================

def paired_bootstrap_delta_rho(
    paired,
    n_boot=10000,
    seed=42,
):
    """
    Paired bootstrap Joint vs Post-hoc.

    IMPORTANT:
        Resampling unit = QUESTION.

    Each sampled question brings BOTH:
        Joint observation
        Post-hoc observation

    Delta rho:
        rho_joint - rho_posthoc
    """

    n = len(paired)

    if n < 3:
        return {
            "rho_joint": np.nan,
            "rho_posthoc": np.nan,
            "delta_rho": np.nan,
            "delta_ci_low": np.nan,
            "delta_ci_high": np.nan,
            "bootstrap_p_two_sided": np.nan,
            "valid_bootstraps": 0,
        }

    rho_joint, _ = safe_spearman(
        paired["ebse_joint"],
        paired["gpt_uncertainty_joint"],
    )

    rho_posthoc, _ = safe_spearman(
        paired["ebse_posthoc"],
        paired["gpt_uncertainty_posthoc"],
    )

    delta_observed = rho_joint - rho_posthoc

    rng = np.random.default_rng(seed)

    deltas = []

    for _ in range(n_boot):

        # SAME question indices sampled for BOTH conditions.
        idx = rng.integers(0, n, size=n)

        sample = paired.iloc[idx]

        rj, _ = safe_spearman(
            sample["ebse_joint"],
            sample["gpt_uncertainty_joint"],
        )

        rp, _ = safe_spearman(
            sample["ebse_posthoc"],
            sample["gpt_uncertainty_posthoc"],
        )

        if np.isfinite(rj) and np.isfinite(rp):
            deltas.append(rj - rp)

    if not deltas:
        return {
            "rho_joint": rho_joint,
            "rho_posthoc": rho_posthoc,
            "delta_rho": delta_observed,
            "delta_ci_low": np.nan,
            "delta_ci_high": np.nan,
            "bootstrap_p_two_sided": np.nan,
            "valid_bootstraps": 0,
        }

    deltas = np.asarray(deltas)

    ci_low = np.percentile(deltas, 2.5)
    ci_high = np.percentile(deltas, 97.5)

    # Bootstrap sign-based two-sided p-value.
    #
    # This is supplementary; the CI is the main result.
    p_lower = np.mean(deltas <= 0)
    p_upper = np.mean(deltas >= 0)

    bootstrap_p = min(
        1.0,
        2 * min(p_lower, p_upper),
    )

    return {
        "rho_joint": rho_joint,
        "rho_posthoc": rho_posthoc,
        "delta_rho": delta_observed,
        "delta_ci_low": ci_low,
        "delta_ci_high": ci_high,
        "bootstrap_p_two_sided": bootstrap_p,
        "valid_bootstraps": len(deltas),
    }


# ============================================================
# EXPERIMENT C1
# ============================================================

def experiment_C1(
    records,
    output_dir,
    ebse_column,
    n_boot,
    seed,
):
    """
    Joint vs Post-hoc paired comparison.

    STRICT requirement:
        SAME questions must occur in both conditions.
    """

    print("=" * 70)
    print("EXPERIMENT C1: JOINT VS POST-HOC")
    print("=" * 70)

    all_data = collect_uncertainty_frames(
        records,
        ebse_column,
    )

    if all_data.empty:
        print("No uncertainty data found.")
        return pd.DataFrame(), pd.DataFrame()

    qc_results = []
    comparison_results = []

    combinations = (
        all_data[["dataset", "model"]]
        .drop_duplicates()
        .sort_values(["dataset", "model"])
    )

    for _, combo in combinations.iterrows():

        dataset = combo["dataset"]
        model = combo["model"]

        subset = all_data[
            (all_data["dataset"] == dataset)
            & (all_data["model"] == model)
        ].copy()

        joint = subset[
            subset["condition"] == "joint"
        ].copy()

        posthoc = subset[
            subset["condition"] == "posthoc"
        ].copy()

        if len(joint) == 0 or len(posthoc) == 0:
            continue

        print()
        print("-" * 70)
        print(f"{dataset} | {model}")
        print("-" * 70)

        qc, exact_match = validate_question_pairing(
            joint,
            posthoc,
        )

        qc_row = {
            "dataset": dataset,
            "model": model,
            **qc,
        }

        qc_results.append(qc_row)

        print(f"Joint rows:       {qc['joint_n']}")
        print(f"Post-hoc rows:    {qc['posthoc_n']}")
        print(f"Shared questions: {qc['shared_questions']}")
        print(f"Joint only:       {qc['joint_only_n']}")
        print(f"Post-hoc only:    {qc['posthoc_only_n']}")
        print(f"Joint duplicates: {qc['joint_duplicate_rows']}")
        print(f"Post duplicates:  {qc['posthoc_duplicate_rows']}")

        if exact_match:
            print("STATUS: PASS - exact question match")
        else:
            print("STATUS: FAIL - question sets are not identical")

            if qc["joint_only_examples"]:
                print(
                    "Joint-only examples:",
                    qc["joint_only_examples"],
                )

            if qc["posthoc_only_examples"]:
                print(
                    "Posthoc-only examples:",
                    qc["posthoc_only_examples"],
                )

            if STRICT_PAIRING:
                print(
                    "Comparison SKIPPED because STRICT_PAIRING=True."
                )
                continue

        # ----------------------------------------------------
        # MERGE ONLY AFTER VALIDATION
        # ----------------------------------------------------

        joint_small = joint[
            [
                "question",
                "ebse",
                "gpt_uncertainty",
            ]
        ].copy()

        post_small = posthoc[
            [
                "question",
                "ebse",
                "gpt_uncertainty",
            ]
        ].copy()

        try:
            paired = joint_small.merge(
                post_small,
                on="question",
                how="inner",
                suffixes=("_joint", "_posthoc"),
                validate="one_to_one",
            )
        except Exception as e:
            print(f"PAIRING ERROR: {e}")
            continue

        # Both conditions need usable EBSE and GPT scores
        # for the paired correlation comparison.
        paired = paired.dropna(
            subset=[
                "ebse_joint",
                "gpt_uncertainty_joint",
                "ebse_posthoc",
                "gpt_uncertainty_posthoc",
            ]
        )

        print(f"Complete paired rows: {len(paired)}")

        stats = paired_bootstrap_delta_rho(
            paired,
            n_boot=n_boot,
            seed=seed,
        )

        comparison_results.append({
            "dataset": dataset,
            "model": model,
            "n_paired": len(paired),
            "ebse_metric": ebse_column,
            **stats,
        })

        print(
            f"Post-hoc rho = {stats['rho_posthoc']:.4f}"
        )
        print(
            f"Joint rho    = {stats['rho_joint']:.4f}"
        )
        print(
            f"Delta rho    = {stats['delta_rho']:.4f}"
        )
        print(
            "95% CI       = "
            f"[{stats['delta_ci_low']:.4f}, "
            f"{stats['delta_ci_high']:.4f}]"
        )
        print(
            "Bootstrap p  = "
            f"{stats['bootstrap_p_two_sided']:.4g}"
        )

    qc_df = pd.DataFrame(qc_results)

    comparison_df = pd.DataFrame(
        comparison_results
    )

    qc_path = (
        output_dir /
        "experiment_C1_pairing_qc.csv"
    )

    comparison_path = (
        output_dir /
        "experiment_C1_joint_vs_posthoc.csv"
    )

    qc_df.to_csv(qc_path, index=False)
    comparison_df.to_csv(comparison_path, index=False)

    print()
    print(f"Saved QC: {qc_path}")
    print(f"Saved comparisons: {comparison_path}")

    # ========================================================
    # AGGREGATE WILCOXON
    # ========================================================

    aggregate_results = []

    if not comparison_df.empty:

        deltas = (
            comparison_df["delta_rho"]
            .dropna()
            .to_numpy()
        )

        n_pairs = len(deltas)

        n_positive = int(np.sum(deltas > 0))
        n_negative = int(np.sum(deltas < 0))
        n_zero = int(np.sum(deltas == 0))

        median_delta = (
            np.median(deltas)
            if n_pairs > 0
            else np.nan
        )

        mean_delta = (
            np.mean(deltas)
            if n_pairs > 0
            else np.nan
        )

        if n_pairs > 0 and not np.all(deltas == 0):

            try:
                w = wilcoxon(
                    deltas,
                    alternative="two-sided",
                    zero_method="wilcox",
                )

                wilcoxon_stat = w.statistic
                wilcoxon_p = w.pvalue

            except Exception:
                wilcoxon_stat = np.nan
                wilcoxon_p = np.nan

        else:
            wilcoxon_stat = np.nan
            wilcoxon_p = np.nan

        aggregate_results.append({
            "n_model_dataset_pairs": n_pairs,
            "mean_delta_rho": mean_delta,
            "median_delta_rho": median_delta,
            "n_joint_higher": n_positive,
            "n_posthoc_higher": n_negative,
            "n_equal": n_zero,
            "wilcoxon_statistic": wilcoxon_stat,
            "wilcoxon_p": wilcoxon_p,
        })

        print()
        print("=" * 70)
        print("C1 AGGREGATE RESULT")
        print("=" * 70)

        print(f"Model-dataset pairs: {n_pairs}")
        print(f"Mean Delta rho:      {mean_delta:.4f}")
        print(f"Median Delta rho:    {median_delta:.4f}")
        print(f"Joint higher:        {n_positive}")
        print(f"Post-hoc higher:     {n_negative}")
        print(f"Equal:               {n_zero}")
        print(f"Wilcoxon p:          {wilcoxon_p:.4g}")

    aggregate_df = pd.DataFrame(
        aggregate_results
    )

    aggregate_path = (
        output_dir /
        "experiment_C1_aggregate.csv"
    )

    aggregate_df.to_csv(
        aggregate_path,
        index=False,
    )

    print(f"Saved aggregate: {aggregate_path}")
    print()

    return comparison_df, qc_df


# ============================================================
# DUPLICATE ANALYSIS CHECK
# ============================================================

def check_duplicate_analysis_files(records):
    """
    Warn if multiple files appear to provide the same
    dataset/model/condition/analysis combination.

    This is important because otherwise the same experiment
    could accidentally enter the results twice.
    """

    rows = []

    for rec in records:

        df = rec["df"]

        if "dataset" not in df.columns or "model" not in df.columns:
            continue

        combinations = (
            df[["dataset", "model"]]
            .drop_duplicates()
        )

        for _, row in combinations.iterrows():

            for analysis_type in rec["types"]:

                rows.append({
                    "dataset": normalize_dataset_name(
                        row["dataset"]
                    ),
                    "model": normalize_model_name(
                        row["model"]
                    ),
                    "condition": rec["condition"],
                    "analysis_type": analysis_type,
                    "file": rec["path"].name,
                })

    check = pd.DataFrame(rows)

    if check.empty:
        return

    counts = (
        check
        .groupby(
            [
                "dataset",
                "model",
                "condition",
                "analysis_type",
            ]
        )
        .size()
        .reset_index(name="n_files")
    )

    duplicates = counts[
        counts["n_files"] > 1
    ]

    if not duplicates.empty:

        print()
        print("!" * 70)
        print("WARNING: POSSIBLE DUPLICATE ANALYSIS FILES")
        print("!" * 70)

        print(duplicates.to_string(index=False))

        print()
        print(
            "Check these before trusting the results. "
            "You may have multiple versions of the same scored file."
        )
        print()


