# ============================================================
# BASIC HELPERS
# ============================================================

def clean_string(x):
    """Normalize strings for comparisons."""
    if pd.isna(x):
        return ""

    x = str(x)
    x = x.strip()
    x = re.sub(r"\s+", " ", x)

    return x


def normalize_question(q):
    """
    Normalize question text ONLY for matching Joint/Post-hoc.

    We deliberately do NOT lowercase or remove punctuation because
    we want the matching check to remain conservative.
    """
    return clean_string(q)


def safe_numeric(series):
    return pd.to_numeric(series, errors="coerce")


def safe_spearman(x, y):
    """
    Compute Spearman correlation safely.

    Returns:
        rho, p

    NaN returned if:
        - fewer than 3 observations
        - either variable is constant
    """

    temp = pd.DataFrame({
        "x": safe_numeric(x),
        "y": safe_numeric(y),
    }).dropna()

    if len(temp) < 3:
        return np.nan, np.nan

    if temp["x"].nunique() < 2:
        return np.nan, np.nan

    if temp["y"].nunique() < 2:
        return np.nan, np.nan

    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        result = spearmanr(temp["x"], temp["y"])

    return float(result.statistic), float(result.pvalue)


# ============================================================
# MODEL / DATASET / CONDITION DETECTION
# ============================================================

def normalize_dataset_name(x):
    x = clean_string(x).lower()

    mappings = {
        "medqa": "MedQA",
        "strategyqa": "StrategyQA",
        "truthfulqa": "TruthfulQA",
    }

    return mappings.get(x, x)


def normalize_model_name(x):
    """
    Preserve actual model names from the CSV as much as possible.
    """
    return clean_string(x)


def detect_condition(df, filepath):
    """
    Determine whether a file corresponds to Joint or Post-hoc.

    Priority:
        1. explicit condition column
        2. filename/path
        3. default = posthoc

    IMPORTANT:
        Since your old post-hoc files don't have a condition column,
        absence of 'joint' is interpreted as posthoc.
    """

    if "condition" in df.columns:
        values = (
            df["condition"]
            .dropna()
            .astype(str)
            .str.lower()
            .str.strip()
            .unique()
        )

        if len(values) == 1:
            value = values[0]

            if "joint" in value:
                return "joint"

            if "post" in value:
                return "posthoc"

    path_text = str(filepath).lower()

    if "joint" in path_text:
        return "joint"

    if "posthoc" in path_text or "post_hoc" in path_text or "post-hoc" in path_text:
        return "posthoc"

    # Based on your pipeline:
    # legacy files without condition = post-hoc.
    return "posthoc"


def detect_file_type(df):
    """
    Determine what analyses this CSV can support.

    A file may theoretically support both.
    """

    types = []

    if "gpt_perceived_uncertainty" in df.columns:
        types.append("uncertainty")

    if "support_score" in df.columns:
        types.append("support")

    return types


# ============================================================
# CORRECTNESS HANDLING
# ============================================================

def get_correctness_column(df):
    """
    MedQA:
        prefer correct_v2 when available.

    StrategyQA / TruthfulQA:
        use correct if correct_v2 does not exist.
    """

    if "correct_v2" in df.columns:
        # Only prefer it if it actually contains usable values.
        numeric = safe_numeric(df["correct_v2"])

        if numeric.notna().sum() > 0:
            return "correct_v2"

    if "correct" in df.columns:
        return "correct"

    return None


def normalize_correctness(series):
    """
    Convert correctness labels into 0/1.
    """

    def convert(x):
        if pd.isna(x):
            return np.nan

        if isinstance(x, (bool, np.bool_)):
            return int(x)

        s = str(x).strip().lower()

        if s in {"1", "1.0", "true", "yes", "correct"}:
            return 1

        if s in {"0", "0.0", "false", "no", "incorrect"}:
            return 0

        try:
            value = float(s)

            if value == 1:
                return 1

            if value == 0:
                return 0

        except Exception:
            pass

        return np.nan

    return series.apply(convert)


# ============================================================
# LOAD FILES
# ============================================================

def load_all_csvs(root_dir):
    """
    Recursively discover usable CSV files.
    """

    root = Path(root_dir)

    files = list(root.rglob("*.csv"))

    print("=" * 70)
    print("FILE DISCOVERY")
    print("=" * 70)
    print(f"Root directory: {root.resolve()}")
    print(f"CSV files found: {len(files)}")
    print()

    records = []

    for path in files:

        try:
            df = pd.read_csv(path)
        except Exception as e:
            print(f"[SKIP] Could not read {path}: {e}")
            continue

        file_types = detect_file_type(df)

        if not file_types:
            continue

        if "model" not in df.columns:
            print(f"[SKIP] No model column: {path}")
            continue

        if "dataset" not in df.columns:
            print(f"[SKIP] No dataset column: {path}")
            continue

        if "question" not in df.columns:
            print(f"[SKIP] No question column: {path}")
            continue

        condition = detect_condition(df, path)

        print(
            f"[FOUND] {path.name}\n"
            f"        rows={len(df)} "
            f"condition={condition} "
            f"type={','.join(file_types)}"
        )

        records.append({
            "path": path,
            "df": df,
            "condition": condition,
            "types": file_types,
        })

    print()
    print(f"Usable files: {len(records)}")
    print()

    return records


# ============================================================
# BOOTSTRAP SPEARMAN CI
# ============================================================

def bootstrap_spearman_ci(
    x,
    y,
    n_boot=10000,
    seed=42,
):
    """
    Non-parametric bootstrap CI for Spearman rho.
    """

    data = pd.DataFrame({
        "x": safe_numeric(x),
        "y": safe_numeric(y),
    }).dropna()

    n = len(data)

    if n < 3:
        return np.nan, np.nan, 0

    x = data["x"].to_numpy()
    y = data["y"].to_numpy()

    rng = np.random.default_rng(seed)

    boot_rhos = []

    for _ in range(n_boot):

        idx = rng.integers(0, n, size=n)

        xb = x[idx]
        yb = y[idx]

        if len(np.unique(xb)) < 2:
            continue

        if len(np.unique(yb)) < 2:
            continue

        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            rho = spearmanr(xb, yb).statistic

        if np.isfinite(rho):
            boot_rhos.append(rho)

    if len(boot_rhos) == 0:
        return np.nan, np.nan, 0

    boot_rhos = np.asarray(boot_rhos)

    lower = np.percentile(boot_rhos, 2.5)
    upper = np.percentile(boot_rhos, 97.5)

    return lower, upper, len(boot_rhos)


