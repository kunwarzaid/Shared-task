import pandas as pd
from scipy.stats import spearmanr

df = pd.read_csv("llama-base_gpt_judge.csv")

valid = df[
    df["explanation"].notna() &
    (df["explanation"].str.strip().str.len() > 50) &
    df["gpt_perceived_uncertainty"].notna()
].copy()

print(f"Valid rows: {len(valid)} / {len(df)}")

r, p = spearmanr(
    valid["norm_ebse"],
    valid["gpt_perceived_uncert_norm"]
)
print(f"Filtered EBSE↔GPT: r={r:.4f}  p={p:.4f}  n={len(valid)}")
