def collect_uncertainty_data(records):

    frames = []

    for rec in records:

        if "uncertainty" not in rec["types"]:
            continue

        df = rec["df"].copy()

        if EBSE_COLUMN not in df.columns:
            continue

        temp = pd.DataFrame({

            "dataset":
                df["dataset"].apply(
                    normalize_dataset_name
                ),

            "model":
                df["model"].apply(
                    normalize_model_name
                ),

            "condition":
                rec["condition"],

            "question":
                df["question"].apply(
                    normalize_question
                ),

            "ebse":
                safe_numeric(
                    df[EBSE_COLUMN]
                ),

            "gpt_uncertainty":
                safe_numeric(
                    df[
                        "gpt_perceived_uncertainty"
                    ]
                ),

            "source_file":
                rec["path"].name,
        })

        frames.append(temp)

    if not frames:
        return pd.DataFrame()

    return pd.concat(
        frames,
        ignore_index=True,
    )


# ============================================================
# 11. SAME-QUESTION CHECK
# ============================================================

def validate_question_pairing(
    joint,
    posthoc,
):

    joint_questions = set(
        joint["question"]
    )

    post_questions = set(
        posthoc["question"]
    )

    shared = (
        joint_questions &
        post_questions
    )

    joint_only = (
        joint_questions -
        post_questions
    )

    post_only = (
        post_questions -
        joint_questions
    )

    joint_duplicates = (
        joint["question"]
        .duplicated()
        .sum()
    )

    post_duplicates = (
        posthoc["question"]
        .duplicated()
        .sum()
    )

    exact_match = (

        len(joint_only) == 0

        and len(post_only) == 0

        and joint_duplicates == 0

        and post_duplicates == 0

        and len(joint) == len(posthoc)
    )

    return {

        "joint_n": len(joint),

        "posthoc_n": len(posthoc),

        "shared_questions":
            len(shared),

        "joint_only_n":
            len(joint_only),

        "posthoc_only_n":
            len(post_only),

        "joint_duplicates":
            joint_duplicates,

        "posthoc_duplicates":
            post_duplicates,

        "exact_match":
            exact_match,

        "joint_only_examples":
            " ||| ".join(
                list(joint_only)[:3]
            ),

        "posthoc_only_examples":
            " ||| ".join(
                list(post_only)[:3]
            ),
    }


# ============================================================
# 12. PAIRED BOOTSTRAP DELTA RHO
# ============================================================

def paired_bootstrap_delta_rho(paired):

    n = len(paired)

    if n < 3:
        return None

    rho_joint, _ = safe_spearman(
        paired["ebse_joint"],
        paired["gpt_uncertainty_joint"],
    )

    rho_posthoc, _ = safe_spearman(
        paired["ebse_posthoc"],
        paired["gpt_uncertainty_posthoc"],
    )

    observed_delta = (
        rho_joint -
        rho_posthoc
    )

    rng = np.random.default_rng(SEED)

    deltas = []

    for _ in range(N_BOOT):

        # CRITICAL:
        #
        # We resample QUESTIONS.
        #
        # The same sampled indices bring both
        # Joint and Post-hoc observations.

        idx = rng.integers(
            0,
            n,
            size=n,
        )

        sample = paired.iloc[idx]

        r_joint, _ = safe_spearman(
            sample["ebse_joint"],
            sample["gpt_uncertainty_joint"],
        )

        r_post, _ = safe_spearman(
            sample["ebse_posthoc"],
            sample["gpt_uncertainty_posthoc"],
        )

        if (
            np.isfinite(r_joint)
            and np.isfinite(r_post)
        ):

            deltas.append(
                r_joint -
                r_post
            )

    deltas = np.asarray(deltas)

    if len(deltas) == 0:
        return None

    ci_low = np.percentile(
        deltas,
        2.5,
    )

    ci_high = np.percentile(
        deltas,
        97.5,
    )

    # Approximate bootstrap sign test
    # around Delta rho = 0.

    p_negative = np.mean(
        deltas <= 0
    )

    p_positive = np.mean(
        deltas >= 0
    )

    bootstrap_p = min(
        1.0,
        2 * min(
            p_negative,
            p_positive,
        ),
    )

    return {

        "rho_joint":
            rho_joint,

        "rho_posthoc":
            rho_posthoc,

        "delta_rho":
            observed_delta,

        "delta_ci95_low":
            ci_low,

        "delta_ci95_high":
            ci_high,

        "bootstrap_p":
            bootstrap_p,

        "valid_bootstraps":
            len(deltas),
    }


# ============================================================
# 13. EXPERIMENT C1
# ============================================================

def experiment_C1(records):

    print("\n" + "=" * 75)
    print("EXPERIMENT C1")
    print("JOINT VS POST-HOC")
    print("=" * 75)

    all_data = collect_uncertainty_data(
        records
    )

    if all_data.empty:

        print("No uncertainty files found.")

        return

    qc_results = []
    comparison_results = []

    combinations = (
        all_data[
            ["dataset", "model"]
        ]
        .drop_duplicates()
    )

    for _, row in combinations.iterrows():

        dataset = row["dataset"]
        model = row["model"]

        subset = all_data[
            (all_data["dataset"] == dataset)
            &
            (all_data["model"] == model)
        ]

        joint = subset[
            subset["condition"] == "joint"
        ].copy()

        posthoc = subset[
            subset["condition"] == "posthoc"
        ].copy()

        # Need BOTH conditions.

        if len(joint) == 0 or len(posthoc) == 0:
            continue

        print("\n" + "-" * 75)
        print(dataset, "|", model)
        print("-" * 75)

        qc = validate_question_pairing(
            joint,
            posthoc,
        )

        qc_results.append({
            "dataset": dataset,
            "model": model,
            **qc,
        })

        print(
            "Joint rows:       ",
            qc["joint_n"]
        )

        print(
            "Post-hoc rows:    ",
            qc["posthoc_n"]
        )

        print(
            "Shared questions: ",
            qc["shared_questions"]
        )

        print(
            "Joint only:       ",
            qc["joint_only_n"]
        )

        print(
            "Post-hoc only:    ",
            qc["posthoc_only_n"]
        )

        print(
            "Joint duplicates: ",
            qc["joint_duplicates"]
        )

        print(
            "Post duplicates:  ",
            qc["posthoc_duplicates"]
        )

        # ----------------------------------------------------
        # THIS IS THE CHECK YOU ASKED FOR
        # ----------------------------------------------------

        if not qc["exact_match"]:

            print(
                "\n*** PAIRING FAILED ***"
            )

            print(
                "Joint and Post-hoc were NOT run "
                "on exactly the same questions."
            )

            if qc["joint_only_examples"]:

                print(
                    "\nExample Joint-only question:"
                )

                print(
                    qc["joint_only_examples"]
                )

            if qc["posthoc_only_examples"]:

                print(
                    "\nExample Post-hoc-only question:"
                )

                print(
                    qc["posthoc_only_examples"]
                )

            if STRICT_PAIRING:

                print(
                    "\nSKIPPING this model-dataset pair."
                )

                continue

        print(
            "\nPAIRING PASSED:"
            " exact same question set."
        )

        # ----------------------------------------------------
        # MERGE BY QUESTION
        # ----------------------------------------------------

        joint_small = joint[
            [
                "question",
                "ebse",
                "gpt_uncertainty",
            ]
        ]

        post_small = posthoc[
            [
                "question",
                "ebse",
                "gpt_uncertainty",
            ]
        ]

        try:

            paired = joint_small.merge(

                post_small,

                on="question",

                how="inner",

                suffixes=(
                    "_joint",
                    "_posthoc",
                ),

                # Prevent accidental many-to-many
                # question matching.
                validate="one_to_one",
            )

        except Exception as e:

            print(
                "\nMERGE FAILED:",
                e
            )

            continue

        # For paired Delta rho analysis,
        # both conditions need usable values.

        paired = paired.dropna(
            subset=[
                "ebse_joint",
                "gpt_uncertainty_joint",
                "ebse_posthoc",
                "gpt_uncertainty_posthoc",
            ]
        )

        print(
            "Complete paired rows:",
            len(paired)
        )

        stats = paired_bootstrap_delta_rho(
            paired
        )

        if stats is None:

            print(
                "Insufficient data for bootstrap."
            )

            continue

        comparison_results.append({

            "dataset":
                dataset,

            "model":
                model,

            "n_paired":
                len(paired),

            "ebse_metric":
                EBSE_COLUMN,

            **stats,
        })

        print(
            f"\nPost-hoc rho = "
            f"{stats['rho_posthoc']:.4f}"
        )

        print(
            f"Joint rho    = "
            f"{stats['rho_joint']:.4f}"
        )

        print(
            f"Delta rho    = "
            f"{stats['delta_rho']:.4f}"
        )

        print(
            f"95% CI       = "
            f"[{stats['delta_ci95_low']:.4f}, "
            f"{stats['delta_ci95_high']:.4f}]"
        )

        print(
            f"Bootstrap p  = "
            f"{stats['bootstrap_p']:.4g}"
        )

    # ========================================================
    # SAVE PAIRING QC
    # ========================================================

    qc_df = pd.DataFrame(
        qc_results
    )

    qc_path = (
        OUTPUT_DIR /
        "experiment_C1_pairing_QC.csv"
    )

    qc_df.to_csv(
        qc_path,
        index=False,
    )

    # ========================================================
    # SAVE C1 RESULTS
    # ========================================================

    comparison_df = pd.DataFrame(
        comparison_results
    )

    comparison_path = (
        OUTPUT_DIR /
        "experiment_C1_joint_vs_posthoc.csv"
    )

    comparison_df.to_csv(
        comparison_path,
        index=False,
    )

    print("\nSaved:", qc_path)
    print("Saved:", comparison_path)

    # ========================================================
    # AGGREGATE WILCOXON
    # ========================================================

    if comparison_df.empty:

        print(
            "\nNo valid Joint/Post-hoc comparisons."
        )

        return

    deltas = (
        comparison_df["delta_rho"]
        .dropna()
        .to_numpy()
    )

    n_pairs = len(deltas)

    n_joint_higher = int(
        np.sum(deltas > 0)
    )

    n_posthoc_higher = int(
        np.sum(deltas < 0)
    )

    n_equal = int(
        np.sum(deltas == 0)
    )

    mean_delta = np.mean(deltas)
    median_delta = np.median(deltas)

    if (
        n_pairs > 0
        and not np.all(deltas == 0)
    ):

        result = wilcoxon(
            deltas,
            alternative="two-sided",
            zero_method="wilcox",
        )

        W = result.statistic
        p = result.pvalue

    else:

        W = np.nan
        p = np.nan

    aggregate_df = pd.DataFrame([{

        "n_model_dataset_pairs":
            n_pairs,

        "mean_delta_rho":
            mean_delta,

        "median_delta_rho":
            median_delta,

        "n_joint_higher":
            n_joint_higher,

        "n_posthoc_higher":
            n_posthoc_higher,

        "n_equal":
            n_equal,

        "wilcoxon_W":
            W,

        "wilcoxon_p":
            p,
    }])

    aggregate_path = (
        OUTPUT_DIR /
        "experiment_C1_aggregate.csv"
    )

    aggregate_df.to_csv(
        aggregate_path,
        index=False,
    )

    print("\n" + "=" * 75)
    print("AGGREGATE JOINT VS POST-HOC")
    print("=" * 75)

    print(
        "Model-dataset pairs:",
        n_pairs
    )

    print(
        "Joint higher:",
        n_joint_higher
    )

    print(
        "Post-hoc higher:",
        n_posthoc_higher
    )

    print(
        "Mean Delta rho:",
        round(mean_delta, 4)
    )

    print(
        "Median Delta rho:",
        round(median_delta, 4)
    )

    print(
        "Wilcoxon W:",
        W
    )

    print(
        "Wilcoxon p:",
        p
    )

    print("\nSaved:", aggregate_path)


