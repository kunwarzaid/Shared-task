# 5. LOAD ALL CSV FILES
# ============================================================

def load_all_csvs():

    files = list(RESULTS_DIR.rglob("*.csv"))

    print("\n" + "=" * 75)
    print("FILE DISCOVERY")
    print("=" * 75)

    print("Results folder:", RESULTS_DIR.resolve())
    print("CSV files found:", len(files))

    records = []

    for path in files:

        try:
            df = pd.read_csv(path)

        except Exception as e:

            print(f"\n[SKIP] Cannot read {path}")
            print(e)

            continue

        types = detect_file_type(df)

        if not types:
            continue

        required = {
            "model",
            "dataset",
            "question",
        }

        missing = required - set(df.columns)

        if missing:

            print(
                f"\n[SKIP] {path.name}: "
                f"missing {missing}"
            )

            continue

        condition = detect_condition(df, path)

        print(
            f"\n[FOUND] {path}"
            f"\n        rows      = {len(df)}"
            f"\n        condition = {condition}"
            f"\n        type      = {', '.join(types)}"
        )

        records.append({
            "path": path,
            "df": df,
            "condition": condition,
            "types": types,
        })

    print("\nUsable files:", len(records))

    return records


# ============================================================
# 6. BOOTSTRAP SPEARMAN CI
# ============================================================

def bootstrap_spearman_ci(x, y):

    data = pd.DataFrame({
        "x": safe_numeric(x),
        "y": safe_numeric(y),
    }).dropna()

    n = len(data)

    if n < 3:
        return np.nan, np.nan, 0

    x = data["x"].to_numpy()
    y = data["y"].to_numpy()

    rng = np.random.default_rng(SEED)

    boot_rhos = []

    for _ in range(N_BOOT):

        idx = rng.integers(
            0,
            n,
            size=n,
        )

        xb = x[idx]
        yb = y[idx]

        if len(np.unique(xb)) < 2:
            continue

        if len(np.unique(yb)) < 2:
            continue

        with warnings.catch_warnings():

            warnings.simplefilter("ignore")

            rho = spearmanr(
                xb,
                yb,
            ).statistic

        if np.isfinite(rho):
            boot_rhos.append(rho)

    if not boot_rhos:
        return np.nan, np.nan, 0

    boot_rhos = np.asarray(boot_rhos)

    low = np.percentile(
        boot_rhos,
        2.5,
    )

    high = np.percentile(
        boot_rhos,
        97.5,
    )

    return low, high, len(boot_rhos)


