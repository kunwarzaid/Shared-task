"""
Run this against your six generations_ecqa_*.csv files before doing
anything else with them. Checks the same categories of problem that
have actually occurred before in this project: incomplete rows,
degenerate confidence, empty explanations, and gold-explanation
coverage as actually achieved (not just theoretical dataset coverage).
"""
import glob
import pandas as pd
import numpy as np

FILES = sorted(glob.glob("generations_ecqa_*.csv"))  # adjust path if needed

if not FILES:
    print("No generations_ecqa_*.csv files found in the current directory.")

for path in FILES:
    df = pd.read_csv(path)
    print(f"\n{'='*70}\n{path}\n{'='*70}")
    print(f"Rows: {len(df)}")

    # 1. Completeness -- any leftover error rows from a failed step?
    n_null_uhat = df["norm_uhat"].isna().sum()
    n_null_just = df["explanation_justificatory"].isna().sum()
    n_null_assess = df["explanation_assessment"].isna().sum()
    print(f"Rows with null norm_uhat (confidence step failed): {n_null_uhat}")
    print(f"Rows with null explanation_justificatory: {n_null_just}")
    print(f"Rows with null explanation_assessment: {n_null_assess}")

    valid = df[df["norm_uhat"].notna()]
    if len(valid) == 0:
        print("NO VALID ROWS -- stop here, do not proceed to judging this file.")
        continue

    # 2. Correctness sanity
    acc = valid["correct"].mean()
    print(f"Accuracy: {acc:.1%} ({valid['correct'].sum()}/{len(valid)})")

    # 3. Confidence degeneracy check (same as MedQA/StrategyQA diagnostics)
    print(f"norm_uhat: mean={valid['norm_uhat'].mean():.4f}  sd={valid['norm_uhat'].std():.4f}")
    print(f"  fraction < 0.01 (near-floor): {(valid['norm_uhat'] < 0.01).mean():.1%}")
    print(f"  fraction > 0.99 (near-ceiling): {(valid['norm_uhat'] > 0.99).mean():.1%}")
    print(f"  distinct values (4dp): {valid['norm_uhat'].round(4).nunique()}")

    # 4. Empty-string explanations (different from null -- model ran but
    #    produced nothing, e.g. immediate EOS)
    empty_just = (valid["explanation_justificatory"].fillna("").str.strip() == "").sum()
    empty_assess = (valid["explanation_assessment"].fillna("").str.strip() == "").sum()
    print(f"Empty-string explanation_justificatory: {empty_just}")
    print(f"Empty-string explanation_assessment: {empty_assess}")

    # 5. Achieved gold-explanation coverage (taskA_pos vs taskA_neg split,
    #    and whether gold_explanation_text is actually non-empty)
    print("\nGold explanation source breakdown:")
    print(valid["gold_explanation_source"].value_counts(dropna=False).to_string())
    empty_gold = (valid["gold_explanation_text"].fillna("").str.strip() == "").sum()
    print(f"Rows with empty gold_explanation_text despite a source being set: {empty_gold}")

    # 6. Quick eyeball: shortest 3 explanations by length, often reveals
    #    truncation or degenerate generations before you trust the whole file
    just_lens = valid["explanation_justificatory"].fillna("").str.len()
    shortest_idx = just_lens.nsmallest(3).index
    print("\nShortest 3 justificatory explanations (check these aren't broken):")
    for i in shortest_idx:
        print(f"  [{just_lens[i]} chars] {valid.loc[i, 'explanation_justificatory']!r}")
