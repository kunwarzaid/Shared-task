"""
STATISTICAL ANALYSIS
Post-hoc Explanation Calibration

Run directly from VS Code.

Analyses:
A. EBSE <-> GPT perceived uncertainty
   - Spearman rho
   - p-value
   - bootstrap 95% CI

B. Correct vs incorrect answer support
   - mean support
   - support gap
   - Mann-Whitney U
   - rank-biserial effect size
   - bootstrap 95% CI

C1. Joint vs Post-hoc
   - SAME-QUESTION verification
   - rho in each condition
   - paired bootstrap Delta rho
   - bootstrap 95% CI
   - aggregate Wilcoxon signed-rank test
"""

from pathlib import Path
import re
import warnings

import numpy as np
import pandas as pd
from scipy.stats import spearmanr, mannwhitneyu, wilcoxon


# ============================================================
# 1. SETTINGS -- EDIT THESE
# ============================================================

# If statistical_analysis.py and results/ are in same folder:
RESULTS_DIR = Path("results")

# Output folder:
OUTPUT_DIR = Path("statistical_results")

# IMPORTANT:
# Set this to the same EBSE column used in your existing paper results.
#
# Options:
# "ebse"
# "norm_ebse"
EBSE_COLUMN = "ebse"

# Use 1000 while testing.
# Change to 10000 for final paper results.
N_BOOT = 1000

SEED = 42

# C1 will refuse to compare Joint/Post-hoc if question sets differ.
STRICT_PAIRING = True


# ============================================================
# 2. HELPERS
# ============================================================

def clean_string(x):

    if pd.isna(x):
        return ""

    x = str(x).strip()
    x = re.sub(r"\s+", " ", x)

    return x


def normalize_question(q):
    """
    Conservative normalization for matching questions.

    Only:
    - strips leading/trailing whitespace
    - collapses repeated whitespace

    Does NOT lowercase/remove punctuation.
    """

    return clean_string(q)


def safe_numeric(series):
    return pd.to_numeric(series, errors="coerce")


def normalize_dataset_name(x):

    x = clean_string(x).lower()

    mapping = {
        "medqa": "MedQA",
        "strategyqa": "StrategyQA",
        "truthfulqa": "TruthfulQA",
    }

    return mapping.get(x, x)


def normalize_model_name(x):
    return clean_string(x)


def safe_spearman(x, y):

    temp = pd.DataFrame({
        "x": safe_numeric(x),
        "y": safe_numeric(y),
    }).dropna()

    if len(temp) < 3:
        return np.nan, np.nan

    if temp["x"].nunique() < 2:
        return np.nan, np.nan

    if temp["y"].nunique() < 2:
        return np.nan, np.nan

    with warnings.catch_warnings():

        warnings.simplefilter("ignore")

        result = spearmanr(
            temp["x"],
            temp["y"],
        )

    return float(result.statistic), float(result.pvalue)


# ============================================================
# 3. DETECT FILE TYPE / CONDITION
# ============================================================

def detect_file_type(df):

    types = []

    if "gpt_perceived_uncertainty" in df.columns:
        types.append("uncertainty")

    if "support_score" in df.columns:
        types.append("support")

    return types


def detect_condition(df, filepath):

    # First preference:
    # explicit condition column

    if "condition" in df.columns:

        values = (
            df["condition"]
            .dropna()
            .astype(str)
            .str.lower()
            .str.strip()
            .unique()
        )

        if len(values) == 1:

            value = values[0]

            if "joint" in value:
                return "joint"

            if "post" in value:
                return "posthoc"

    # Second preference:
    # filename / folder

    text = str(filepath).lower()

    if "joint" in text:
        return "joint"

    if (
        "posthoc" in text
        or "post_hoc" in text
        or "post-hoc" in text
    ):
        return "posthoc"

    # Your old files are post-hoc by default.
    return "posthoc"


# ============================================================
# 4. CORRECTNESS
# ============================================================

def get_correctness_column(df):

    # Prefer GPT-rechecked correctness where available.

    if "correct_v2" in df.columns:

        numeric = safe_numeric(df["correct_v2"])

        if numeric.notna().sum() > 0:
            return "correct_v2"

    if "correct" in df.columns:
        return "correct"

    return None


def normalize_correctness(series):

    def convert(x):

        if pd.isna(x):
            return np.nan

        if isinstance(x, (bool, np.bool_)):
            return int(x)

        s = str(x).strip().lower()

        if s in {
            "1",
            "1.0",
            "true",
            "yes",
            "correct",
        }:
            return 1

        if s in {
            "0",
            "0.0",
            "false",
            "no",
            "incorrect",
        }:
            return 0

        try:

            value = float(s)

            if value == 1:
                return 1

            if value == 0:
                return 0

        except Exception:
            pass

        return np.nan

    return series.apply(convert)


