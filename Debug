def experiment_B(records):

    print("\n" + "=" * 75)
    print("EXPERIMENT B")
    print("JUSTIFICATION BIAS")
    print("=" * 75)

    results = []

    for rec in records:

        if "support" not in rec["types"]:
            continue

        df = rec["df"].copy()

        correctness_col = get_correctness_column(df)

        if correctness_col is None:

            print(
                f"\n[B SKIP] {rec['path'].name}: "
                "no correctness column"
            )

            continue

        df["_correct"] = normalize_correctness(
            df[correctness_col]
        )

        df["_support"] = safe_numeric(
            df["support_score"]
        )

        for (dataset, model), g in df.groupby(
            ["dataset", "model"]
        ):

            dataset = normalize_dataset_name(dataset)
            model = normalize_model_name(model)

            temp = g[
                ["_correct", "_support"]
            ].dropna()

            correct_scores = temp.loc[
                temp["_correct"] == 1,
                "_support",
            ].to_numpy()

            incorrect_scores = temp.loc[
                temp["_correct"] == 0,
                "_support",
            ].to_numpy()

            if (
                len(correct_scores) == 0
                or len(incorrect_scores) == 0
            ):
                continue

            mw = mannwhitneyu(
                correct_scores,
                incorrect_scores,
                alternative="two-sided",
            )

            effect = rank_biserial(
                correct_scores,
                incorrect_scores,
            )

            ci_low, ci_high, n_valid_boot = (
                bootstrap_rank_biserial_ci(
                    correct_scores,
                    incorrect_scores,
                )
            )

            mean_correct = np.mean(
                correct_scores
            )

            mean_incorrect = np.mean(
                incorrect_scores
            )

            # IMPORTANT:
            # Positive gap = correct answers receive
            # more support than incorrect answers.

            support_gap = (
                mean_correct -
                mean_incorrect
            )

            rho, rho_p = safe_spearman(
                temp["_correct"],
                temp["_support"],
            )

            results.append({

                "dataset": dataset,
                "model": model,
                "condition": rec["condition"],

                "n_total": len(temp),
                "n_correct": len(correct_scores),
                "n_incorrect": len(incorrect_scores),

                "support_correct_mean":
                    mean_correct,

                "support_incorrect_mean":
                    mean_incorrect,

                "support_gap_correct_minus_incorrect":
                    support_gap,

                "mannwhitney_U":
                    mw.statistic,

                "mannwhitney_p":
                    mw.pvalue,

                "rank_biserial":
                    effect,

                "rank_biserial_ci95_low":
                    ci_low,

                "rank_biserial_ci95_high":
                    ci_high,

                "spearman_correctness_support":
                    rho,

                "spearman_p":
                    rho_p,

                "source_file":
                    rec["path"].name,
            })

            print(
                f"\n{dataset}"
                f"\n{model}"
                f"\nCondition: {rec['condition']}"
                f"\nCorrect support:   {mean_correct:.2f}"
                f"\nIncorrect support: {mean_incorrect:.2f}"
                f"\nGap (C-I):         {support_gap:.2f}"
                f"\nMW p:              {mw.pvalue:.4g}"
                f"\nRank-biserial:     {effect:.4f}"
                f"\n95% CI: [{ci_low:.4f}, {ci_high:.4f}]"
            )

    result_df = pd.DataFrame(results)

    path = (
        OUTPUT_DIR /
        "experiment_B_justification.csv"
    )

    result_df.to_csv(
        path,
        index=False,
    )

    print("\nSaved:", path)

    return result_df


