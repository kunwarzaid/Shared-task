"""
Compare closed-form MedQA U-hat (from closed_form_medqa.py) against
the original sampling-based U-hat, for the same model and questions.

Two things this produces, both needed for the paper:
1. Updated Experiment A correlation (U-hat vs communicated
   uncertainty) using the closed-form, noise-free estimator.
2. Updated EBSE-validity check (correct vs incorrect U-hat,
   Mann-Whitney) using the closed-form estimator.

Run this after (a) closed_form_medqa.py has produced a CSV with
norm_uhat, and (b) you have run the GPT uncertainty judge on the
same explanations (the judge script works unchanged -- just point
INPUT_CSV at the closed-form output file).
"""

import pandas as pd
import numpy as np
from scipy.stats import spearmanr, mannwhitneyu

# =====================================================
# CONFIG
# =====================================================

CLOSED_FORM_JUDGED_CSV = "medqa_llama_instruct_closed_form_judged.csv"
ORIGINAL_SAMPLING_JUDGED_CSV = "llama_instruct_gpt_judge.csv"

# =====================================================
# LOAD BOTH
# =====================================================

closed = pd.read_csv(CLOSED_FORM_JUDGED_CSV)
original = pd.read_csv(ORIGINAL_SAMPLING_JUDGED_CSV)

# =====================================================
# EXPERIMENT A: CORRELATION COMPARISON
# =====================================================

def compute_correlation(df, uhat_col, judge_col="gpt_perceived_uncertainty"):
    sub = df[df[uhat_col].notna() & df[judge_col].notna()].copy()
    sub["judge_norm"] = sub[judge_col] / 100.0
    r, p = spearmanr(sub[uhat_col], sub["judge_norm"])
    return r, p, len(sub)

r_closed, p_closed, n_closed = compute_correlation(closed, "norm_uhat")
r_original, p_original, n_original = compute_correlation(original, "norm_ebse")

print("=== Experiment A: Closed-form vs Sampling-based ===")
print(f"Closed-form:     r={r_closed:.4f}  p={p_closed:.4f}  n={n_closed}")
print(f"Sampling-based:  r={r_original:.4f}  p={p_original:.4f}  n={n_original}")

# =====================================================
# VALIDITY CHECK: CORRECT VS INCORRECT U-HAT
# =====================================================

def validity_check(df, uhat_col, correct_col="correct"):
    valid = df[df[uhat_col].notna() & df[correct_col].notna()]
    correct_vals = valid[valid[correct_col] == 1][uhat_col]
    incorrect_vals = valid[valid[correct_col] == 0][uhat_col]
    if len(correct_vals) < 2 or len(incorrect_vals) < 2:
        return None
    u, p = mannwhitneyu(correct_vals, incorrect_vals)
    return {
        "mean_correct": correct_vals.mean(),
        "mean_incorrect": incorrect_vals.mean(),
        "sd_correct": correct_vals.std(),
        "sd_incorrect": incorrect_vals.std(),
        "n_correct": len(correct_vals),
        "n_incorrect": len(incorrect_vals),
        "p": p,
    }

print("\n=== Validity check: Closed-form vs Sampling-based ===")
closed_validity = validity_check(closed, "norm_uhat")
original_validity = validity_check(original, "norm_ebse")

if closed_validity:
    print(f"Closed-form:    correct={closed_validity['mean_correct']:.4f} "
          f"(sd={closed_validity['sd_correct']:.4f}, n={closed_validity['n_correct']}) | "
          f"incorrect={closed_validity['mean_incorrect']:.4f} "
          f"(sd={closed_validity['sd_incorrect']:.4f}, n={closed_validity['n_incorrect']}) | "
          f"p={closed_validity['p']:.4f}")

if original_validity:
    print(f"Sampling-based: correct={original_validity['mean_correct']:.4f} "
          f"(sd={original_validity['sd_correct']:.4f}, n={original_validity['n_correct']}) | "
          f"incorrect={original_validity['mean_incorrect']:.4f} "
          f"(sd={original_validity['sd_incorrect']:.4f}, n={original_validity['n_incorrect']}) | "
          f"p={original_validity['p']:.4f}")

# =====================================================
# VARIANCE DIAGNOSTICS FOR BOTH
# =====================================================

print("\n=== Variance diagnostics ===")
for label, df, col in [("Closed-form", closed, "norm_uhat"),
                        ("Sampling-based", original, "norm_ebse")]:
    s = df[col].dropna()
    print(f"{label}: SD={s.std():.4f} | "
          f"floor%={(s < 1e-6).mean():.1%} | "
          f"ceiling%={(s > 1-1e-6).mean():.1%} | "
          f"distinct_values={s.round(6).nunique()}")

print("\nSaved comparison complete. Report both rows in the paper's")
print("variance-audit discussion, showing the closed-form estimator")
print("removes the floor/ceiling degeneracy the sampling-based")
print("estimator exhibited.")
