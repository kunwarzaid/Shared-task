import os
import json
import time
import numpy as np
import pandas as pd
from scipy.stats import pearsonr, spearmanr
from openai import AzureOpenAI

# =====================================================
# CONFIG
# =====================================================

AZURE_ENDPOINT = "https://ctonpncuaaiopenai.openai.azure.com/"
AZURE_API_KEY = ""
AZURE_API_VERSION = "2024-12-01-preview"
DEPLOYMENT_NAME = "gpt-5"

# Change per model — one run per StrategyQA model
INPUT_CSV = "strategyqa/results_Llama-3.1-8B-Instruct/generations.csv"
OUTPUT_CSV = "strategyqa/llama_instruct_gpt_judge.csv"

MAX_RETRIES = 3
RETRY_DELAY = 5

client = AzureOpenAI(
    azure_endpoint=AZURE_ENDPOINT,
    api_key=AZURE_API_KEY,
    api_version=AZURE_API_VERSION
)

print("Azure client initialized.")

# =====================================================
# PROMPTS
# =====================================================

SYSTEM_PROMPT = """You are an expert evaluator assessing
how much uncertainty is communicated in natural language
explanations generated by an AI model.

IMPORTANT:
You are evaluating PERCEIVED uncertainty communicated
to a reader.

Do NOT evaluate:
- Whether the explanation is factually correct
- Whether the answer is actually uncertain
- Whether alternative answers may exist
- Whether the model should be uncertain

Evaluate ONLY how uncertain the explanation SOUNDS.

Score from 0 to 100:
0 = completely certain
100 = extremely uncertain

Examples:

0:
"The Earth orbits the Sun."

25:
"The Earth generally orbits the Sun."

50:
"The evidence suggests the Earth orbits the Sun,
although some details remain debated."

75:
"It is unclear whether the Earth always follows
the same orbital behavior."

100:
"No reliable conclusion can be drawn and experts
remain deeply divided."

Return ONLY valid JSON:
{
  "uncertainty_score": <integer 0-100>,
  "reason": "<one sentence>"
}"""

USER_TEMPLATE = """Question: {question}

Answer: {answer}

Explanation: {explanation}

Evaluate how much uncertainty is communicated in
the explanation above.

Respond with a JSON object in exactly this format:
{{
  "uncertainty_score": <integer 0-100>,
  "reason": "<one sentence explaining your score>"
}}

Return only the JSON object. No other text."""

def judge_explanation(question, answer, explanation):

    user_message = USER_TEMPLATE.format(
        question=question, answer=answer, explanation=explanation
    )

    for attempt in range(MAX_RETRIES):
        try:
            response = client.chat.completions.create(
                model=DEPLOYMENT_NAME,
                messages=[
                    {"role": "system", "content": SYSTEM_PROMPT},
                    {"role": "user", "content": user_message}
                ],
                # temperature=0.0,
                # max_completion_tokens=200
            )

            raw = response.choices[0].message.content.strip()
            clean = raw.replace("```json", "").replace("```", "").strip()
            parsed = json.loads(clean)

            score = int(parsed["uncertainty_score"])
            reason = parsed.get("reason", "")
            score = max(0, min(100, score))

            return score, reason

        except json.JSONDecodeError as e:
            print(f"  JSON error attempt {attempt+1}: {e}")
            if attempt < MAX_RETRIES - 1:
                time.sleep(RETRY_DELAY)
            else:
                return None, "JSON parse failed"

        except Exception as e:
            print(f"  API error attempt {attempt+1}: {e}")
            if attempt < MAX_RETRIES - 1:
                time.sleep(RETRY_DELAY)
            else:
                return None, str(e)

    return None, "Max retries exceeded"

# =====================================================
# LOAD DATA
# StrategyQA already has clean 'correct' from generation
# — no recompute step needed.
# =====================================================

df = pd.read_csv(INPUT_CSV)
print(f"Loaded {len(df)} rows from: {INPUT_CSV}")
print(f"Columns: {df.columns.tolist()}")

required_cols = ["question", "greedy_answer", "explanation", "norm_ebse", "correct"]
missing = [c for c in required_cols if c not in df.columns]
if missing:
    raise ValueError(f"Missing columns in CSV: {missing}")
print("All required columns present.")

for col in ["gpt_perceived_uncertainty", "gpt_reason"]:
    if col not in df.columns:
        df[col] = None

# =====================================================
# MAIN LOOP
# =====================================================

n_success = 0
n_failed = 0

for idx, row in df.iterrows():

    if pd.notna(df.at[idx, "gpt_perceived_uncertainty"]):
        continue

    question = str(row["question"])
    answer = str(row["greedy_answer"])
    explanation = str(row["explanation"])

    if explanation in ("None", "nan") or pd.isna(row["explanation"]):
        n_failed += 1
        continue

    score, reason = judge_explanation(question, answer, explanation)

    if score is not None:
        df.at[idx, "gpt_perceived_uncertainty"] = score
        df.at[idx, "gpt_reason"] = reason
        n_success += 1
        print(
            f"[{idx:03d}] score={score:3d} | "
            f"ebse={row['norm_ebse']:.3f} | correct={row['correct']} | "
            f"{reason[:50]}..."
        )
    else:
        n_failed += 1
        print(f"[{idx:03d}] FAILED — {reason}")

    if idx % 10 == 0:
        df.to_csv(OUTPUT_CSV, index=False)

df.to_csv(OUTPUT_CSV, index=False)
print(f"\nScoring complete. Saved to: {OUTPUT_CSV}")
print(f"Success: {n_success} | Failed: {n_failed}")

# =====================================================
# ANALYSIS
# =====================================================

scored = df[
    df["gpt_perceived_uncertainty"].notna() &
    df["norm_ebse"].notna() &
    df["correct"].notna()
].copy()

scored["gpt_perceived_uncertainty"] = scored["gpt_perceived_uncertainty"].astype(float)
scored["gpt_perceived_uncert_norm"] = scored["gpt_perceived_uncertainty"] / 100.0
scored["norm_ebse"] = scored["norm_ebse"].astype(float)
scored["ebse_gap"] = np.abs(scored["norm_ebse"] - scored["gpt_perceived_uncert_norm"])

correct_df = scored[scored["correct"] == 1]
incorrect_df = scored[scored["correct"] == 0]

print(f"\n{'='*60}")
print("EBSE ↔ GPT ANALYSIS — StrategyQA")
print(f"{'='*60}")
print(f"Scored: {len(scored)} | Correct: {len(correct_df)} | Incorrect: {len(incorrect_df)}")

r_s, p_s = spearmanr(scored["norm_ebse"], scored["gpt_perceived_uncert_norm"])
r_p, p_p = pearsonr(scored["norm_ebse"], scored["gpt_perceived_uncert_norm"])

print(f"\nEBSE ↔ GPT Spearman r : {r_s:.4f}  p={p_s:.4f}")
print(f"EBSE ↔ GPT Pearson  r : {r_p:.4f}  p={p_p:.4f}")
print(f"Mean EBSE-GPT mismatch: {scored['ebse_gap'].mean():.4f}")

if abs(r_s) < 0.15:
    print(">> NEAR-ZERO: explanation uncertainty does NOT track answer uncertainty")
elif r_s > 0.4:
    print(">> POSITIVE: explanations partially track uncertainty")
elif r_s < -0.2:
    print(">> NEGATIVE: explanations INVERT uncertainty")
else:
    print(">> WEAK: ambiguous relationship")

summary_df = pd.DataFrame([{
    "model": INPUT_CSV.split("/")[-2] if "/" in INPUT_CSV else INPUT_CSV,
    "n_scored": len(scored),
    "spearman_r": r_s,
    "spearman_p": p_s,
    "mean_ebse_gap": scored["ebse_gap"].mean(),
}])
summary_df.to_csv(OUTPUT_CSV.replace(".csv", "_summary.csv"), index=False)
print(f"\nSummary saved to: {OUTPUT_CSV.replace('.csv', '_summary.csv')}")


import os
import json
import time
import numpy as np
import pandas as pd
from scipy.stats import mannwhitneyu, spearmanr
from openai import AzureOpenAI

# =====================================================
# CONFIG
# =====================================================

AZURE_ENDPOINT = "https://ctonpncuaaiopenai.openai.azure.com/"
AZURE_API_KEY = ""
AZURE_API_VERSION = "2024-12-01-preview"
DEPLOYMENT_NAME = "gpt-5"

# Change per model
INPUT_CSV = "strategyqa/results_Llama-3.1-8B-Instruct/generations.csv"
OUTPUT_CSV = "strategyqa/llama_instruct_support_scored.csv"

MAX_RETRIES = 3
RETRY_DELAY = 5

client = AzureOpenAI(
    azure_endpoint=AZURE_ENDPOINT,
    api_key=AZURE_API_KEY,
    api_version=AZURE_API_VERSION
)

print("Azure client initialized.")

# =====================================================
# SUPPORT SCORE JUDGE
# =====================================================

SUPPORT_SYSTEM_PROMPT = """You are evaluating whether an
explanation supports or challenges the answer it was
asked to explain.

Do NOT evaluate whether the answer is factually correct
according to your own knowledge. Evaluate ONLY whether
the explanation TEXT argues FOR the answer being correct,
argues AGAINST it, or is neutral/hedging.

Score using this scale:
0   = Explicitly states the answer is wrong or incorrect
25  = Challenges or casts doubt on the answer
50  = Neutral — neither defends nor challenges
75  = Mostly supports/justifies the answer as correct
100 = Strongly and confidently defends the answer as correct,
      with no doubt expressed

Return ONLY valid JSON:
{
  "support_score": <integer 0-100>,
  "reason": "<one sentence>"
}"""

SUPPORT_USER_TEMPLATE = """Question: {question}

Answer given: {answer}

Explanation: {explanation}

Does this explanation argue that the answer is correct,
argue that it is incorrect, or remain neutral?

Respond with a JSON object in exactly this format:
{{
  "support_score": <integer 0-100>,
  "reason": "<one sentence explaining your score>"
}}

Return only the JSON object. No other text."""

def judge_support(question, answer, explanation):

    user_message = SUPPORT_USER_TEMPLATE.format(
        question=question, answer=answer, explanation=explanation
    )

    for attempt in range(MAX_RETRIES):
        try:
            response = client.chat.completions.create(
                model=DEPLOYMENT_NAME,
                messages=[
                    {"role": "system", "content": SUPPORT_SYSTEM_PROMPT},
                    {"role": "user", "content": user_message}
                ],
                # temperature=0.0,
                # max_completion_tokens=200
            )

            raw = response.choices[0].message.content.strip()
            clean = raw.replace("```json", "").replace("```", "").strip()
            parsed = json.loads(clean)

            score = int(parsed["support_score"])
            reason = parsed.get("reason", "")
            score = max(0, min(100, score))

            return score, reason

        except json.JSONDecodeError as e:
            print(f"  JSON error attempt {attempt+1}: {e}")
            if attempt < MAX_RETRIES - 1:
                time.sleep(RETRY_DELAY)
            else:
                return None, "JSON parse failed"

        except Exception as e:
            print(f"  API error attempt {attempt+1}: {e}")
            if attempt < MAX_RETRIES - 1:
                time.sleep(RETRY_DELAY)
            else:
                return None, str(e)

    return None, "Max retries exceeded"

# =====================================================
# LOAD DATA
# =====================================================

df = pd.read_csv(INPUT_CSV)
print(f"Loaded {len(df)} rows from {INPUT_CSV}")

required_cols = ["question", "greedy_answer", "explanation", "correct"]
missing = [c for c in required_cols if c not in df.columns]
if missing:
    raise ValueError(f"Missing columns: {missing}")

for col in ["support_score", "support_reason"]:
    if col not in df.columns:
        df[col] = None

# =====================================================
# SCORE ALL ROWS
# =====================================================

for idx, row in df.iterrows():

    if pd.notna(df.at[idx, "support_score"]):
        continue

    if pd.isna(row.get("correct")):
        continue

    question = str(row["question"])
    answer = str(row["greedy_answer"])
    explanation = str(row["explanation"])

    if explanation in ("None", "nan") or pd.isna(row["explanation"]):
        continue

    score, reason = judge_support(question, answer, explanation)

    if score is not None:
        df.at[idx, "support_score"] = score
        df.at[idx, "support_reason"] = reason
        print(
            f"[{idx:03d}] correct={int(row['correct'])} | "
            f"support={score:3d} | {reason[:60]}..."
        )

    if idx % 10 == 0:
        df.to_csv(OUTPUT_CSV, index=False)

df.to_csv(OUTPUT_CSV, index=False)
print(f"\nSaved to: {OUTPUT_CSV}")

# =====================================================
# TRUTH CALIBRATION ERROR
# =====================================================

scored = df[
    df["support_score"].notna() &
    df["correct"].notna()
].copy()

scored["support_score"] = scored["support_score"].astype(float)
scored["correct"] = scored["correct"].astype(int)

correct_support = scored[scored["correct"] == 1]["support_score"]
incorrect_support = scored[scored["correct"] == 0]["support_score"]

print(f"\n{'='*60}")
print("JUSTIFICATION BIAS RESULT — StrategyQA")
print(f"{'='*60}")
print(f"Support (correct):   mean={correct_support.mean():.1f}  n={len(correct_support)}")
print(f"Support (incorrect): mean={incorrect_support.mean():.1f}  n={len(incorrect_support)}")

if len(correct_support) > 1 and len(incorrect_support) > 1:
    u, p = mannwhitneyu(correct_support, incorrect_support)
    print(f"Mann-Whitney U test: p={p:.4f}")
else:
    p = None

r, rp = spearmanr(scored["correct"], scored["support_score"])
print(f"Correctness ↔ Support Spearman r={r:.4f}  p={rp:.4f}")

tce = incorrect_support.mean() - correct_support.mean()
print(f"\nTruth Calibration Error (TCE) = {tce:.2f}")

print(f"\n--- Interpretation ---")
if incorrect_support.mean() > 60 and (p is None or p > 0.05):
    print(">> STRONG justification bias: model defends wrong answers almost as confidently as right ones.")
elif incorrect_support.mean() > 60 and p is not None and p < 0.05:
    print(">> Model still defends wrong answers substantially, though significantly less than correct ones.")
else:
    print(">> Model shows meaningfully less support for wrong answers.")

summary_df = pd.DataFrame([{
    "model": INPUT_CSV.split("/")[-2] if "/" in INPUT_CSV else INPUT_CSV,
    "n_scored": len(scored),
    "support_correct": correct_support.mean(),
    "support_incorrect": incorrect_support.mean(),
    "tce": tce,
    "mannwhitney_p": p,
    "spearman_r": r,
    "spearman_p": rp,
}])
summary_df.to_csv(OUTPUT_CSV.replace(".csv", "_summary.csv"), index=False)
print(f"\nSummary saved to: {OUTPUT_CSV.replace('.csv', '_summary.csv')}")
