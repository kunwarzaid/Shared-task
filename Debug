# ============================================================
# RANK-BISERIAL CORRELATION
# ============================================================

def rank_biserial(correct_scores, incorrect_scores):
    """
    Rank-biserial correlation corresponding to Mann-Whitney U.

    Direction:
        positive -> correct answers receive higher support
        negative -> incorrect answers receive higher support

    Formula:
        RBC = 2U/(n_correct*n_incorrect) - 1

    where U is calculated with correct scores as group 1.
    """

    correct_scores = np.asarray(correct_scores, dtype=float)
    incorrect_scores = np.asarray(incorrect_scores, dtype=float)

    if len(correct_scores) == 0 or len(incorrect_scores) == 0:
        return np.nan

    u = mannwhitneyu(
        correct_scores,
        incorrect_scores,
        alternative="two-sided",
    ).statistic

    return (2 * u) / (
        len(correct_scores) * len(incorrect_scores)
    ) - 1


def bootstrap_rank_biserial_ci(
    correct_scores,
    incorrect_scores,
    n_boot=10000,
    seed=42,
):
    """
    Bootstrap CI for rank-biserial correlation.

    Groups are resampled separately.
    """

    c = np.asarray(correct_scores, dtype=float)
    i = np.asarray(incorrect_scores, dtype=float)

    if len(c) == 0 or len(i) == 0:
        return np.nan, np.nan, 0

    rng = np.random.default_rng(seed)

    values = []

    for _ in range(n_boot):

        cb = rng.choice(c, size=len(c), replace=True)
        ib = rng.choice(i, size=len(i), replace=True)

        effect = rank_biserial(cb, ib)

        if np.isfinite(effect):
            values.append(effect)

    if not values:
        return np.nan, np.nan, 0

    values = np.asarray(values)

    return (
        np.percentile(values, 2.5),
        np.percentile(values, 97.5),
        len(values),
    )


