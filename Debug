"""
GPT uncertainty judge, run on the six joint-condition closed-form
MedQA generation files (from closed_form_medqa_joint.py).

Same judge prompt as the post-hoc pipeline (Appendix D of the
paper), unchanged. Loops over all six generations_closed_form_joint_*.csv
files automatically, scoring communicated uncertainty for each
explanation, and saves judged output ready for
compare_closed_form_vs_sampling.py (Experiment A correlations) and
the joint-condition validity check.
"""

import os
import time
import json
import glob
import pandas as pd
from pathlib import Path
from openai import AzureOpenAI

# =====================================================
# CONFIG
# =====================================================

AZURE_ENDPOINT = "https://ctonpncuaaiopenai.openai.azure.com/"
AZURE_API_KEY = "5bc17f3698774aed9e7529e4bcecc2c1"
AZURE_API_VERSION = "2024-12-01-preview"
DEPLOYMENT_NAME = "gpt-5"

INPUT_DIR = "MedQA/closed_form_joint"
INPUT_PATTERN = "generations_closed_form_joint_*.csv"
OUTPUT_DIR = "MedQA/closed_form_joint/gpt_judge"

Path(OUTPUT_DIR).mkdir(exist_ok=True, parents=True)

client = AzureOpenAI(
    azure_endpoint=AZURE_ENDPOINT,
    api_key=AZURE_API_KEY,
    api_version=AZURE_API_VERSION,
)
print("Azure OpenAI client initialized.")

# =====================================================
# JUDGE PROMPT -- identical to the post-hoc pipeline,
# unchanged (Appendix D)
# =====================================================

SYSTEM_PROMPT = """You are an expert evaluator assessing how much uncertainty is communicated in natural language explanations generated by an AI model.

IMPORTANT: You are evaluating PERCEIVED uncertainty communicated to a reader.

Do NOT evaluate: whether the explanation is factually correct; whether the answer is actually uncertain; whether alternative answers may exist; whether the model should be uncertain.

Evaluate ONLY how uncertain the explanation SOUNDS.

Score from 0 to 100: 0 = completely certain, 100 = extremely uncertain.

Return ONLY valid JSON:
{"uncertainty_score": <integer 0-100>, "reason": "<one sentence>"}"""


def build_user_message(question, answer, explanation):
    return (
        f"Question: {question}\n\n"
        f"Answer: {answer}\n\n"
        f"Explanation: {explanation}\n\n"
        f"Evaluate how much uncertainty is communicated in the explanation "
        f"above. Respond with a JSON object in exactly this format:\n"
        f'{{"uncertainty_score": <integer 0-100>, "reason": "<one sentence '
        f'explaining your score>"}}\n'
        f"Return only the JSON object. No other text."
    )


def score_uncertainty(question, answer, explanation, max_retries=3):
    if pd.isna(explanation) or str(explanation).strip() == "":
        return None, "empty explanation"

    user_message = build_user_message(question, answer, explanation)

    for attempt in range(max_retries):
        try:
            response = client.chat.completions.create(
                model=DEPLOYMENT_NAME,
                messages=[
                    {"role": "system", "content": SYSTEM_PROMPT},
                    {"role": "user", "content": user_message},
                ],
            )
            raw = response.choices[0].message.content.strip()

            if raw.startswith("```"):
                raw = raw.strip("`")
                if raw.lower().startswith("json"):
                    raw = raw[4:].strip()

            parsed = json.loads(raw)
            score = int(parsed["uncertainty_score"])
            reason = parsed.get("reason", "")

            if not (0 <= score <= 100):
                raise ValueError(f"Score out of range: {score}")

            return score, reason

        except Exception as e:
            print(f"    Attempt {attempt+1}/{max_retries} failed: {e}")
            if attempt < max_retries - 1:
                time.sleep(2)
            else:
                return None, f"failed after {max_retries} attempts: {e}"


def process_file(input_path):
    filename = os.path.basename(input_path)
    output_path = os.path.join(OUTPUT_DIR, filename.replace(".csv", "_gpt_judge.csv"))

    if os.path.exists(output_path):
        existing = pd.read_csv(output_path)
        if "gpt_perceived_uncertainty" in existing.columns and \
           existing["gpt_perceived_uncertainty"].notna().sum() >= len(existing) * 0.9:
            print(f"\nSKIP {filename}: already scored at {output_path}")
            return existing

    print(f"\n{'='*60}")
    print(f"PROCESSING: {filename}")
    print(f"{'='*60}")

    df = pd.read_csv(input_path)
    print(f"Loaded {len(df)} rows.")

    required_cols = ["question", "greedy_answer", "explanation", "correct", "norm_uhat"]
    missing = [c for c in required_cols if c not in df.columns]
    if missing:
        print(f"  SKIP: missing columns {missing}. Present: {df.columns.tolist()}")
        return None

    scores = []
    reasons = []

    for idx, row in df.iterrows():
        print(f"[{idx:03d}/{len(df)}] {str(row['question'])[:70]}...")

        score, reason = score_uncertainty(
            row["question"], row["greedy_answer"], row["explanation"]
        )

        print(f"  gpt_perceived_uncertainty={score} | {str(reason)[:80]}")

        scores.append(score)
        reasons.append(reason)

        if idx % 10 == 0:
            checkpoint = df.copy()
            checkpoint["gpt_perceived_uncertainty"] = scores + [None] * (len(df) - len(scores))
            checkpoint["gpt_reason"] = reasons + [None] * (len(df) - len(reasons))
            checkpoint.to_csv(output_path, index=False)

    df["gpt_perceived_uncertainty"] = scores
    df["gpt_reason"] = reasons
    df.to_csv(output_path, index=False)

    valid = df[df["gpt_perceived_uncertainty"].notna() & df["norm_uhat"].notna()]
    print(f"\n--- SUMMARY: {filename} ---")
    print(f"Scored: {len(valid)} / {len(df)}")
    print(f"Saved to: {output_path}\n")

    return df


# =====================================================
# RUN ACROSS ALL SIX JOINT CLOSED-FORM FILES
# =====================================================

files = sorted(glob.glob(os.path.join(INPUT_DIR, INPUT_PATTERN)))
print(f"Found {len(files)} joint closed-form generation files:")
for f in files:
    print(f"  {f}")

if len(files) == 0:
    raise FileNotFoundError(
        f"No files matched {os.path.join(INPUT_DIR, INPUT_PATTERN)}. "
        f"Check INPUT_DIR matches your actual path."
    )

for filepath in files:
    process_file(filepath)

print("="*70)
print("ALL 6 MODELS JUDGED (joint condition, closed-form)")
print("="*70)
print(f"Output files in: {OUTPUT_DIR}/")
print("\nNext step: run compare_closed_form_vs_sampling.py per model,")
print("pointing CLOSED_FORM_JUDGED_CSV at each of these six output files,")
print("to get the joint-condition Experiment A correlations and the")
print("Mann-Whitney p-values for the validity check.")
